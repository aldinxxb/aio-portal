PREFIX aio:  <https://w3id.org/aio#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# The requirements implied by ONE problem-definition value
# (a study objective, an intent, a scenario, a driver, an output or a challenge).
# One row per combination of optional values: the Python side groups the rows.
SELECT DISTINCT ?req ?type ?label ?rationale ?strength ?weight ?ruleId
                ?onProperty ?allowedValue ?allowedLiteral ?appliesTo
WHERE {
  {{value}} aio:impliesRequirement ?req .
  ?req a ?type .
  VALUES ?type { aio:MethodRequirement aio:DataRequirement aio:PresentationRequirement }
  OPTIONAL { ?req rdfs:label ?label .
             FILTER(lang(?label) = "en" || lang(?label) = "") }
  OPTIONAL { ?req aio:rationale ?rationale .
             FILTER(lang(?rationale) = "en" || lang(?rationale) = "") }
  OPTIONAL { ?req aio:hasStrength ?strength }
  OPTIONAL { ?req aio:requirementWeight ?weight }
  OPTIONAL { ?req aio:ruleId ?ruleId }
  OPTIONAL { ?req aio:onProperty ?onProperty }
  OPTIONAL { ?req aio:allowedValue ?allowedValue }
  OPTIONAL { ?req aio:allowedLiteral ?allowedLiteral }
  OPTIONAL { ?req aio:appliesToVariableType ?appliesTo }
}