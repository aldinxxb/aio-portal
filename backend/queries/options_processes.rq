PREFIX aio: <https://w3id.org/aio#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item ?label (COUNT(DISTINCT ?method) AS ?count)
WHERE {
  {{challenge}} aio:involvesProcess ?item .
  OPTIONAL { ?item rdfs:label ?label }
  OPTIONAL { ?method aio:modelsProcess ?item }
}
GROUP BY ?item ?label
ORDER BY ?label