PREFIX aio: <https://w3id.org/aio#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?method ?methodLabel ?process ?input ?inputLabel
WHERE {
  {{challenge}} aio:involvesProcess ?process .
  ?method aio:modelsProcess ?process .
  OPTIONAL { ?method rdfs:label ?methodLabel }
  OPTIONAL {
    ?method aio:requiresMandatoryInput ?input .
    OPTIONAL { ?input rdfs:label ?inputLabel }
  }
}
ORDER BY ?methodLabel