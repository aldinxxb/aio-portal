#################################################################
#    Object properties
#################################################################

###  https://w3id.org/aio/software#implementsMethod
aiosw:implementsMethod a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "implements method"@en ;
    rdfs:range aio:ModelingMethod .

###  https://w3id.org/aio/software#moduleOf
aiosw:moduleOf a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module of"@en ;
    rdfs:range aio:SoftwarePlatform .

###  https://w3id.org/aio/software#moduleTimeStepClass
aiosw:moduleTimeStepClass a owl:ObjectProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module time-step class"@en ;
    rdfs:range aio:TimeStepClass .

#################################################################
#    Data properties
#################################################################

###  https://w3id.org/aio/software#moduleName
aiosw:moduleName a owl:DatatypeProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module name"@en .

###  https://w3id.org/aio/software#moduleResolution
aiosw:moduleResolution a owl:DatatypeProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module spatial resolution"@en ;
    skos:definition "Usual size of the computational unit in practice, as text."@en .

###  https://w3id.org/aio/software#moduleSpatialUnit
aiosw:moduleSpatialUnit a owl:DatatypeProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module spatial unit"@en ;
    skos:definition "The computational unit: subbasin, HRU, grid cell, mesh element, cross-section..."@en .

###  https://w3id.org/aio/software#moduleTimeStep
aiosw:moduleTimeStep a owl:DatatypeProperty ;
    rdfs:domain aiosw:SoftwareModule ;
    rdfs:label "module time step"@en ;
    skos:definition "Time step usually used for this module in this software, as text."@en .

#################################################################
#    Classes
#################################################################

###  https://w3id.org/aio/software#SoftwareModule
aiosw:SoftwareModule a owl:Class ;
    rdfs:label "software module"@en ;
    skos:definition "The implementation of one method inside one software (e.g. the MIKE SHE unsaturated-zone module using Richards equation), with the time step and spatial resolution it is usually run at in that software."@en .

