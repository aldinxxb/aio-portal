###  https://w3id.org/aio#DiffusiveWave2D
:DiffusiveWave2D rdf:type owl:NamedIndividual ,
                          :HydraulicMethod ,
                          :ModelingMethod ;
                 :acceptsOptionalInput :Precipitation ,
                                       :WaterLevel ;
                 :canBeImplementedIn :HEC-HMS ,
                                     :HEC-RAS ;
                 :hasApplicationScale :CatchmentScale ,
                                      :ReachScale ;
                 :hasDimensionality :Dim2D ;
                 :hasPhysicalParameter :ManningRoughnessCoefficient ,
                                       :TerrainSlope ;
                 :hasSpatialRepresentation :FullyDistributed ;
                 :hasTemporalMode :EventBased ;
                 :hasTypicalTimeStep :SubHourly ;
                 :isCalibratedAgainst :HistoricalFloodLevel ,
                                      :WaterLevel ;
                 :modelsProcess :ChannelFlow ,
                                :Runoff ;
                 :producesOutput :Discharge ,
                                 :FlowVelocity ,
                                 :PeakDischarge ,
                                 :WaterLevel ;
                 :requiresMandatoryInput :DTM ,
                                         :Discharge ;
                 rdfs:label "2D diffusive wave"@en .


