                            :ModelingMethod ;
                   :acceptsOptionalInput :WaterLevel ;
                   :canBeImplementedIn :HEC-RAS ,
                                       :MIKE11 ,
                                       :TELEMAC-2D ;
                   :hasApplicationScale :CatchmentScale ,
                                        :ReachScale ;
                   :hasDimensionality :Dim1D ;
                   :hasPhysicalParameter :ChannelSlope ,
                                         :ManningRoughnessCoefficient ;
                   :hasSpatialRepresentation :SemiDistributed ;
                   :hasTemporalMode :Continuous ,
                                    :EventBased ;
                   :hasTypicalTimeStep :Hourly ,
                                       :SubHourly ;
                   :isCalibratedAgainst :Discharge ,
                                        :WaterLevel ;
                   :modelsProcess :ChannelFlow ;
                   :producesOutput :Discharge ,
                                   :FlowVelocity ,
                                   :WaterLevel ;
                   :requiresMandatoryInput :ChannelGeometry ,
                                           :Discharge ;
                   rdfs:label "1D channel elements"@en .


###  https://w3id.org/aio#ChannelFlow
:ChannelFlow rdf:type owl:NamedIndividual ,
                      :Process ,
                      :SurfaceProcess ;
             :enablesTransportOf :PollutantTransport ,
                                 :SedimentTransport ;
             :hasParticipant :Catchement ,
                             :Lake ,
                             :River ,
                             :Stream ,
                             :Watershed ;
             :isRepresentedBy :Discharge ,
                              :FlowVelocity ,
                              :PeakDischarge ;
             :modifiesVariable :ShearStress ,
                               :WaterLevel ;
             rdfs:label "channel flow"@en .


###  https://w3id.org/aio#ChannelGeometry
:ChannelGeometry rdf:type owl:NamedIndividual ,
                          :HydraulicVariable ,
                          :ParameterVariable ;
                 :parameterizesProcess :ChannelFlow ,
                                       :SedimentTransport ;
                 rdfs:label "channel geometry"@en ;
                 skos:definition "Shape and dimensions of the channel cross-section (width, depth, bank slopes)."@en .


###  https://w3id.org/aio#ChannelSlope
:ChannelSlope rdf:type owl:NamedIndividual ,
                       :ParameterVariable ;
              :parameterizesProcess :ChannelFlow ,
                                    :SedimentTransport ;
              rdfs:label "channel slope"@en .


###  https://w3id.org/aio#Clark-UH
:Clark-UH rdf:type owl:NamedIndividual ,
                   :HydrologicalMethod ,
                   :ModelingMethod ;
          :canBeImplementedIn :HEC-HMS ,
                              :SWAT ;
          :hasApplicationScale :CatchmentScale ;
          :hasCalibrationParameter :StorageCoefficient ;
          :hasPhysicalParameter :TimeOfConcentration ;
          :hasSpatialRepresentation :Lumped ;
          :hasTemporalMode :EventBased ;
          :hasTypicalTimeStep :Hourly ,
                              :SubHourly ;
          :isCalibratedAgainst :Discharge ;
          :modelsProcess :Runoff ;
          :producesOutput :Discharge ,
                          :PeakDischarge ;
          :requiresMandatoryInput :RunoffVolume ;
          rdfs:label "Clark unit hydrograph"@en .


