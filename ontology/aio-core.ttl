###  https://w3id.org/aio#TemperatureIndexMethod
aio:TemperatureIndexMethod a aio:HydrologicalMethod ,
        aio:ModelingMethod ,
        owl:NamedIndividual ;
    aio:acceptsOptionalInput aio:SnowCover ,
        aio:SnowDepth ,
        aio:SnowWaterEquivalent ;
    aio:canBeImplementedIn aio:HEC-HMS ,
        aio:ISBA ,
        aio:MIKESHE ,
        aio:SWAT ;
    aio:hasApplicationScale aio:CatchmentScale ,
        aio:RegionalScale ;
    aio:hasCalibrationParameter aio:DegreeDayFactor ;
    aio:hasSpatialRepresentation aio:FullyDistributed ,
        aio:Lumped ,
        aio:SemiDistributed ;
    aio:hasTemporalMode aio:Continuous ;
    aio:hasTypicalTimeStep aio:Daily ;
    aio:isCalibratedAgainst aio:Discharge ,
        aio:SnowCover ,
        aio:SnowWaterEquivalent ;
    aio:modelsProcess aio:Snowmelt ;
    aio:producesOutput aio:SnowCover ,
        aio:SnowWaterEquivalent ,
        aio:SnowmeltAmount ;
    aio:requiresMandatoryInput aio:AirTemperature ,
        aio:Precipitation ;
    aio:supportsTimeStep aio:Daily ,
        aio:Hourly ;
    rdfs:label "temperature-index (degree-day) snowmelt method"@en ;
    skos:altLabel "Degree Day Snowmelt"@en ,
        "Temperature Index Snowmelt"@en ,
        "degree-day method"@en ,
        "temperature index method"@en ,
        "temperature index"@en ;
    skos:definition "Snowmelt computed as a degree-day factor times the air temperature above a threshold; snow accumulates from precipitation below a rain/snow temperature threshold. Variants add cold content and antecedent temperature index (e.g. HEC-HMS temperature index)."@en .

