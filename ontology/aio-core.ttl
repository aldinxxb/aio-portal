        owl:NamedIndividual ;
    aio:containsVariable aio:SnowCoverVIIRS ,
        aio:SnowSurfaceTemperatureVIIRS ;
    aio:hasTemporalNature aio:TimeSeriesRecord ;
    aio:isOngoing "true"^^xsd:boolean ;
    dcat:landingPage <https://nsidc.org/data/viirs/data> ;
    dct:publisher aio:NASAEarthData ;
    dct:spatial aio:Global ;
