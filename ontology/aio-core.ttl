@prefix : <https://w3id.org/aio#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <https://w3id.org/aio> .

<https://w3id.org/aio> rdf:type owl:Ontology ;
                        owl:versionIRI <https://w3id.org/aio/0.7.0> ;
                        dct:description "Ontology linking water-related problems, hydrological processes, modelling methods, software platforms and datasets, to support the selection of models and data for a given water question."@en ;
                        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
                        dct:modified "2026-11-10"^^xsd:date ;
                        dct:title "AIO ontology"@en ;
                        vann:preferredNamespacePrefix "aio" ;
                        vann:preferredNamespaceUri "https://w3id.org/aio#" ;
                        owl:versionInfo "0.7.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dct:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dct:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dct:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dct:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/dcat#bbox
dcat:bbox rdf:type owl:AnnotationProperty ;
          rdfs:label "bounding box"@en .


###  http://www.w3.org/ns/dcat#endDate
dcat:endDate rdf:type owl:AnnotationProperty ;
             rdfs:label "end date"@en .


###  http://www.w3.org/ns/dcat#startDate
dcat:startDate rdf:type owl:AnnotationProperty ;
               rdfs:label "start date"@en .


###  http://www.w3.org/ns/dcat#temporalResolution
dcat:temporalResolution rdf:type owl:AnnotationProperty ;
                        rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
                        rdfs:label "temporal resolution"@en .


###  https://w3id.org/aio#derivationMethod
:derivationMethod rdf:type owl:AnnotationProperty ;
                  rdfs:label "derivation method"@en .


###  https://w3id.org/aio#developedBy
:developedBy rdf:type owl:AnnotationProperty ;
             rdfs:label "developed by"@en .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
geo:wktLiteral rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/publisher
dct:publisher rdf:type owl:ObjectProperty ;
              rdfs:isDefinedBy <http://purl.org/dc/terms> ;
              rdfs:label "publisher"@en .


###  http://purl.org/dc/terms/spatial
dct:spatial rdf:type owl:ObjectProperty ;
            rdfs:range :GeographicArea ;
            rdfs:isDefinedBy dct: ;
            rdfs:label "spatial coverage"@en ;
            skos:definition "Area covered by the dataset (DCAT/DCT)."@en .


###  http://purl.org/dc/terms/temporal
dct:temporal rdf:type owl:ObjectProperty ;
             rdfs:range dct:PeriodOfTime ;
             rdfs:isDefinedBy dct: ;
             rdfs:label "temporal coverage"@en ;
             skos:definition "Period covered by the dataset (DCAT/DCT)."@en .


###  http://qudt.org/schema/qudt/hasUnit
qudt:hasUnit rdf:type owl:ObjectProperty ;
             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
             rdfs:label "has unit"@en .


###  http://www.w3.org/ns/dcat#dataset
dcat:dataset rdf:type owl:ObjectProperty ;
             rdfs:label "dataset"@en .


###  http://www.w3.org/ns/dcat#landingPage
dcat:landingPage rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
                 rdfs:label "landing page"@en .


###  https://w3id.org/aio#acceptsOptionalInput
:acceptsOptionalInput rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :requiresInput ;
                      rdfs:domain :ModelingMethod ;
                      rdfs:range :Variable ;
                      rdfs:label "accepts optional input"@en ;
                      skos:definition "Relates a method to an input that improves results but is not required."@en .


###  https://w3id.org/aio#actsOn
:actsOn rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :definesProblem ;
        rdfs:domain :Factor ;
        rdfs:range :WaterEntity ;
        rdfs:label "acts on"@en ;
        skos:definition "Relates a factor to a water entity it affects."@en .


###  https://w3id.org/aio#affectsProcess
:affectsProcess rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :definesProblem ;
                owl:inverseOf :isAffectedBy ;
                rdfs:domain :Factor ;
                rdfs:range :Process ;
                owl:propertyChainAxiom ( :isCharacterizedBy
                                         :controlsProcess
                                       ) ;
                rdfs:label "affects process"@en ;
                skos:definition "Relates a factor to a process it affects. Inferred by the reasoner: a factor characterized by a variable that controls a process affects that process."@en .


###  https://w3id.org/aio#canBeImplementedIn
:canBeImplementedIn rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasModelingProperty ;
                    rdfs:domain :ModelingMethod ;
                    rdfs:range :SoftwarePlatform ;
                    rdfs:label "can be implemented in"@en ;
                    skos:definition "Relates a modelling method to a software platform in which it is available."@en .


###  https://w3id.org/aio#characterizesFactor
:characterizesFactor rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :definesProblem ;
                     owl:inverseOf :isCharacterizedBy ;
                     rdfs:domain :Variable ;
                     rdfs:range :Factor ;
                     rdfs:label "characterizes factor"@en ;
                     skos:definition "Inverse of is characterized by."@en .


###  https://w3id.org/aio#concernsWaterEntity
:concernsWaterEntity rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :definesProblem ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :DecisionIntent
                                                 :UserQuestion
                                               )
                                 ] ;
                     rdfs:range :WaterEntity ;
                     rdfs:label "concerns water entity"@en ;
                     skos:definition "Relates a user question or decision intent to the water entity it is about."@en .


###  https://w3id.org/aio#considersChallenge
:considersChallenge rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :definesProblem ;
                    rdfs:domain :UserQuestion ;
                    rdfs:range :WaterChallenge ;
                    rdfs:label "considers challenge"@en ;
                    skos:definition "Relates a user question to the water challenge it addresses."@en .


###  https://w3id.org/aio#considersDriver
:considersDriver rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :definesProblem ;
                 rdfs:domain :UserQuestion ;
                 rdfs:range :Factor ;
                 rdfs:label "considers driver"@en ;
                 skos:definition "Relates a user question to a factor it takes into account."@en .


###  https://w3id.org/aio#constrainsProcess
:constrainsProcess rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :controlsProcess ;
                   owl:inverseOf :isConstrainedBy ;
                   rdfs:domain :StateVariable ;
                   rdfs:range :Process ;
                   rdfs:label "constrains process"@en ;
                   skos:definition "Relates a state variable to a process whose rate it limits as an antecedent or current condition (e.g. soil moisture constrains evapotranspiration)."@en .


###  https://w3id.org/aio#containsVariable
:containsVariable rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasDataRelation ;
                  rdfs:domain dcat:Dataset ;
                  rdfs:range :DataVariable ;
                  rdfs:label "contains variable"@en ;
                  skos:definition "Relates a dataset to a data variable it provides."@en .


###  https://w3id.org/aio#controlsProcess
:controlsProcess rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasSystemProperty ;
                 owl:inverseOf :isControlledBy ;
                 rdfs:domain :Variable ;
                 rdfs:range :Process ;
                 rdfs:label "controls process"@en ;
                 skos:definition "Relates a variable to a process whose rate or magnitude it determines. Abstract parent: assert one of drives, constrains or parameterizes process."@en .


###  https://w3id.org/aio#definedUnderScenario
:definedUnderScenario rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :definesProblem ;
                      rdfs:domain :Factor ;
                      rdfs:range :Scenario ;
                      rdfs:label "defined under scenario"@en ;
                      skos:definition "Relates a factor to the scenario under which it is considered."@en .


###  https://w3id.org/aio#definesProblem
:definesProblem rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:label "defines problem"@en ;
                skos:definition "Grouping property for relations that define a user's problem."@en .


###  https://w3id.org/aio#derivesVariable
:derivesVariable rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasDataRelation ;
                 owl:inverseOf :isDerivedBy ;
                 rdfs:domain :Derivation ;
                 rdfs:range :Variable ;
                 rdfs:label "derives variable"@en ;
                 skos:definition "Relates a derivation to the variable it produces."@en .


###  https://w3id.org/aio#drivesProcess
:drivesProcess rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :controlsProcess ;
               owl:inverseOf :isDrivenBy ;
               rdfs:domain :Variable ;
               rdfs:range :Process ;
               rdfs:label "drives process"@en ;
               skos:definition "Relates a time-varying forcing variable to a process it drives (e.g. precipitation drives runoff). Implies time-series data."@en .


###  https://w3id.org/aio#enablesTransportOf
:enablesTransportOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :influencesProcess ;
                    rdfs:domain :Process ;
                    rdfs:range :Process ;
                    rdfs:label "enables transport of"@en ;
                    skos:definition "Relates a process to a transport process for which it provides the carrying flow."@en .


###  https://w3id.org/aio#expressesIntent
:expressesIntent rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :definesProblem ;
                 rdfs:domain :UserQuestion ;
                 rdfs:range :DecisionIntent ;
                 rdfs:label "expresses intent"@en ;
                 skos:definition "Relates a user question to the decision intent it expresses."@en .


###  https://w3id.org/aio#hasAcquisitionMethod
:hasAcquisitionMethod rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasDataRelation ;
                      rdfs:domain :DataVariable ;
                      rdfs:range :AcquisitionMethod ;
                      rdfs:label "has acquisition method"@en ;
                      skos:definition "Relates a data variable to how its data were acquired."@en .


###  https://w3id.org/aio#hasApplicationScale
:hasApplicationScale rdf:type owl:ObjectProperty ;
                     rdfs:domain :ModelingMethod ;
                     rdfs:range :ApplicationScale ;
                     rdfs:label "has application scale"@en ;
                     skos:definition "Typical size of system modelled."@en .


###  https://w3id.org/aio#hasCalibrationParameter
:hasCalibrationParameter rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasParameter ;
                         rdfs:domain :ModelingMethod ;
                         rdfs:range :Variable ;
                         rdfs:label "has calibration parameter"@en ;
                         skos:definition "Relates a method to a parameter fitted by calibration against observations; needs no dataset, but needs calibration data."@en .


###  https://w3id.org/aio#hasDataRelation
:hasDataRelation rdf:type owl:ObjectProperty ;
                 rdfs:label "has data relation"@en ;
                 skos:definition "Grouping property for relations between datasets, data variables and system variables."@en .


###  https://w3id.org/aio#hasDimensionality
:hasDimensionality rdf:type owl:ObjectProperty ;
                   rdfs:domain :ModelingMethod ;
                   rdfs:range :SpatialDimensionality ;
                   rdfs:label "has dimensionality"@en ;
                   skos:definition "Spatial dimensions solved by the method."@en .


###  https://w3id.org/aio#hasExpectedOutput
:hasExpectedOutput rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :definesProblem ;
                   rdfs:domain :StudyObjective ;
                   rdfs:range :ExpectedOutput ;
                   rdfs:label "has expected output"@en ;
                   skos:definition "Relates a study objective to the output it is expected to produce."@en .


###  https://w3id.org/aio#hasLicenceCategory
:hasLicenceCategory rdf:type owl:ObjectProperty ;
                    rdfs:domain :SoftwarePlatform ;
                    rdfs:range :LicenceCategory ;
                    rdfs:label "has licence category"@en ;
                    skos:definition "Access model of the software platform."@en .


###  https://w3id.org/aio#hasModelingProperty
:hasModelingProperty rdf:type owl:ObjectProperty ;
                     rdfs:label "has modeling property"@en ;
                     skos:definition "Grouping property for relations describing modelling methods and software."@en .


###  https://w3id.org/aio#hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :requiresVariables ;
              rdfs:label "has parameter"@en ;
              skos:definition "Relates a modelling method to a variable it needs as a parameter."@en .


###  https://w3id.org/aio#hasParticipant
:hasParticipant rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasSystemProperty ;
                owl:inverseOf :participatesIn ;
                rdfs:domain :Process ;
                rdfs:range :WaterEntity ;
                rdfs:label "has participant"@en ;
                skos:definition "Relates a process to a water entity that takes part in it."@en .


###  https://w3id.org/aio#hasPhysicalParameter
:hasPhysicalParameter rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasParameter ;
                      rdfs:domain :ModelingMethod ;
                      rdfs:range :Variable ;
                      rdfs:label "has physical parameter"@en ;
                      skos:definition "Relates a method to a parameter estimated from data or by derivation (e.g. soil hydraulic properties)."@en .


###  https://w3id.org/aio#hasPrimaryProcess
:hasPrimaryProcess rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :involvesProcess ;
                   owl:inverseOf :isPrimaryProcessOf ;
                   rdfs:domain :WaterChallenge ;
                   rdfs:range :Process ;
                   rdfs:label "has primary process"@en ;
                   skos:definition "Relates a water challenge to a process that defines it: the challenge cannot be modelled without it."@en .


###  https://w3id.org/aio#hasProvenance
:hasProvenance rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDataRelation ;
               rdfs:domain :DataVariable ;
               rdfs:range :DataProvenance ;
               rdfs:label "has provenance"@en ;
               skos:definition "Relates a data variable to how its values were produced. Observed and remote-sensing data can be used for calibration."@en .


###  https://w3id.org/aio#hasSecondaryProcess
:hasSecondaryProcess rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :involvesProcess ;
                     owl:inverseOf :isSecondaryProcessOf ;
                     rdfs:domain :WaterChallenge ;
                     rdfs:range :Process ;
                     rdfs:label "has secondary process"@en ;
                     skos:definition "Relates a water challenge to a process that modulates it."@en .


###  https://w3id.org/aio#hasSpatialRepresentation
:hasSpatialRepresentation rdf:type owl:ObjectProperty ;
                          rdfs:domain :ModelingMethod ;
                          rdfs:range :SpatialRepresentation ;
                          rdfs:label "has spatial representation"@en ;
                          skos:definition "How the method discretises space."@en .


###  https://w3id.org/aio#hasSystemProperty
:hasSystemProperty rdf:type owl:ObjectProperty ;
                   rdfs:label "has system property"@en ;
                   skos:definition "Grouping property for relations within the physical water system."@en .


###  https://w3id.org/aio#hasTemporalMode
:hasTemporalMode rdf:type owl:ObjectProperty ;
                 rdfs:domain :ModelingMethod ;
                 rdfs:range :TemporalMode ;
                 rdfs:label "has temporal mode"@en ;
                 skos:definition "Event, continuous or steady-state use."@en .


###  https://w3id.org/aio#hasTemporalNature
:hasTemporalNature rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:Dataset ;
                   rdfs:range :TemporalNature ;
                   rdfs:label "has temporal nature"@en ;
                   skos:definition "Links a dataset to its temporal nature."@en .


###  https://w3id.org/aio#hasTypicalTimeStep
:hasTypicalTimeStep rdf:type owl:ObjectProperty ;
                    rdfs:domain :ModelingMethod ;
                    rdfs:range :TimeStepClass ;
                    rdfs:label "has typical time step"@en ;
                    skos:definition "Typical computational time step."@en .


###  https://w3id.org/aio#influencesProcess
:influencesProcess rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasSystemProperty ;
                   owl:inverseOf :isInfluencedBy ;
                   rdfs:domain :Process ;
                   rdfs:range :Process ;
                   rdfs:label "influences process"@en ;
                   skos:definition "Relates a process to another process whose behaviour it affects."@en .


###  https://w3id.org/aio#involvesProcess
:involvesProcess rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :definesProblem ;
                 owl:inverseOf :isInvolvedIn ;
                 rdfs:domain :WaterChallenge ;
                 rdfs:range :Process ;
                 rdfs:label "involves process"@en ;
                 skos:definition "Relates a water challenge to a process relevant to it."@en .


###  https://w3id.org/aio#isAffectedBy
:isAffectedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :definesProblem ;
              rdfs:domain :Process ;
              rdfs:range :Factor ;
              rdfs:label "is affected by"@en ;
              skos:definition "Inverse of affects process."@en .


###  https://w3id.org/aio#isCalibratedAgainst
:isCalibratedAgainst rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasModelingProperty ;
                     rdfs:domain :ModelingMethod ;
                     rdfs:range :Variable ;
                     rdfs:label "is calibrated against"@en ;
                     skos:definition "Relates a method to a variable whose observations are used to calibrate or validate it."@en .


###  https://w3id.org/aio#isCharacterizedBy
:isCharacterizedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :definesProblem ;
                   rdfs:domain :Factor ;
                   rdfs:range :Variable ;
                   rdfs:label "is characterized by"@en ;
                   skos:definition "Relates a factor to a measurable variable that characterises it (e.g. urbanization is characterized by impervious fraction)."@en .


###  https://w3id.org/aio#isConstrainedBy
:isConstrainedBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isControlledBy ;
                 rdfs:domain :Process ;
                 rdfs:range :StateVariable ;
                 rdfs:label "is constrained by"@en ;
                 skos:definition "Inverse of constrains process."@en .


###  https://w3id.org/aio#isControlledBy
:isControlledBy rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasSystemProperty ;
                rdfs:domain :Process ;
                rdfs:range :Variable ;
                rdfs:label "is controlled by"@en ;
                skos:definition "Inverse of controls process."@en .


###  https://w3id.org/aio#isDerivableFrom
:isDerivableFrom rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasDataRelation ;
                 rdfs:domain :Variable ;
                 rdfs:range :Variable ;
                 owl:propertyChainAxiom ( :isDerivedBy
                                          :requiresDerivationInput
                                        ) ;
                 rdfs:label "is derivable from"@en ;
                 skos:definition "Inferred: the variable can be derived from the other variable (through a derivation)."@en .


###  https://w3id.org/aio#isDerivedBy
:isDerivedBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasDataRelation ;
             rdfs:domain :Variable ;
             rdfs:range :Derivation ;
             rdfs:label "is derived by"@en ;
             skos:definition "Inverse of derives variable."@en .


###  https://w3id.org/aio#isDirectlyRelevantTo
:isDirectlyRelevantTo rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :isRelevantToChallenge ;
                      rdfs:domain :Factor ;
                      rdfs:range :WaterChallenge ;
                      owl:propertyChainAxiom ( :affectsProcess
                                               :isPrimaryProcessOf
                                             ) ;
                      rdfs:label "is directly relevant to"@en ;
                      skos:definition "Inferred: the factor affects a primary process of the challenge."@en .


###  https://w3id.org/aio#isDrivenBy
:isDrivenBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isControlledBy ;
            rdfs:domain :Process ;
            rdfs:range :Variable ;
            rdfs:label "is driven by"@en ;
            skos:definition "Inverse of drives process."@en .


###  https://w3id.org/aio#isIndirectlyRelevantTo
:isIndirectlyRelevantTo rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isRelevantToChallenge ;
                        rdfs:domain :Factor ;
                        rdfs:range :WaterChallenge ;
                        owl:propertyChainAxiom ( :affectsProcess
                                                 :isSecondaryProcessOf
                                               ) ;
                        rdfs:label "is indirectly relevant to"@en ;
                        skos:definition "Inferred: the factor affects a secondary process of the challenge."@en .


###  https://w3id.org/aio#isInfluencedBy
:isInfluencedBy rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasSystemProperty ;
                rdfs:domain :Process ;
                rdfs:range :Process ;
                rdfs:label "is influenced by"@en ;
                skos:definition "Inverse of influences process."@en .


###  https://w3id.org/aio#isInvolvedIn
:isInvolvedIn rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :definesProblem ;
              rdfs:domain :Process ;
              rdfs:range :WaterChallenge ;
              rdfs:label "is involved in"@en ;
              skos:definition "Inverse of involves process: relates a process to a water challenge it is part of."@en .


###  https://w3id.org/aio#isModifiedBy
:isModifiedBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasSystemProperty ;
              owl:inverseOf :modifiesVariable ;
              rdfs:domain :StateVariable ;
              rdfs:range :Process ;
              rdfs:label "is modified by"@en ;
              skos:definition "Inverse of modifies variable."@en .


###  https://w3id.org/aio#isParameterizedBy
:isParameterizedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isControlledBy ;
                   owl:inverseOf :parameterizesProcess ;
                   rdfs:domain :Process ;
                   rdfs:range :ParameterVariable ;
                   rdfs:label "is parameterized by"@en ;
                   skos:definition "Inverse of parameterizes process."@en .


###  https://w3id.org/aio#isPrimaryProcessOf
:isPrimaryProcessOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :isInvolvedIn ;
                    rdfs:domain :Process ;
                    rdfs:range :WaterChallenge ;
                    rdfs:label "is primary process of"@en ;
                    skos:definition "Inverse of has primary process."@en .


###  https://w3id.org/aio#isRelevantToChallenge
:isRelevantToChallenge rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :definesProblem ;
                       rdfs:domain :Factor ;
                       rdfs:range :WaterChallenge ;
                       rdfs:label "is relevant to challenge"@en ;
                       skos:definition "Relates a factor to a water challenge it is relevant to; parent of the inferred direct and indirect relevance."@en .


###  https://w3id.org/aio#isRepresentedBy
:isRepresentedBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasSystemProperty ;
                 owl:inverseOf :representsProcess ;
                 rdfs:domain :Process ;
                 rdfs:range :FluxVariable ;
                 owl:propertyDisjointWith :modifiesVariable ;
                 rdfs:label "is represented by"@en ;
                 skos:definition "Relates a process to a flux variable that quantifies it (its rate or produced amount)."@en .


###  https://w3id.org/aio#isSecondaryProcessOf
:isSecondaryProcessOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :isInvolvedIn ;
                      rdfs:domain :Process ;
                      rdfs:range :WaterChallenge ;
                      rdfs:label "is secondary process of"@en ;
                      skos:definition "Inverse of has secondary process."@en .


###  https://w3id.org/aio#isTriggeredBy
:isTriggeredBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isAffectedBy ;
               owl:inverseOf :triggersProcess ;
               rdfs:domain :Process ;
               rdfs:range :Factor ;
               rdfs:label "is triggered by"@en ;
               skos:definition "Inverse of triggers process."@en .


###  https://w3id.org/aio#isWithin
:isWithin rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :GeographicArea ;
          rdfs:range :GeographicArea ;
          rdfs:label "is within"@en ;
          skos:definition "Area A lies inside area B. Transitive, so a dataset covering B is a candidate for any study area within B."@en .


###  https://w3id.org/aio#modelsProcess
:modelsProcess rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasModelingProperty ;
               rdfs:domain :ModelingMethod ;
               rdfs:range :Process ;
               rdfs:label "models process"@en ;
               skos:definition "Relates a modelling method to a process it represents."@en .


###  https://w3id.org/aio#modifiesVariable
:modifiesVariable rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasSystemProperty ;
                  rdfs:domain :Process ;
                  rdfs:range :StateVariable ;
                  rdfs:label "modifies variable"@en ;
                  skos:definition "Relates a process to a state variable it changes directly. Downstream effects are expressed between processes, not here."@en .


###  https://w3id.org/aio#parameterizesProcess
:parameterizesProcess rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :controlsProcess ;
                      rdfs:domain :ParameterVariable ;
                      rdfs:range :Process ;
                      rdfs:label "parameterizes process"@en ;
                      skos:definition "Relates a mostly static property to a process it parameterises (e.g. hydraulic conductivity parameterizes infiltration). Implies map or table data."@en .


###  https://w3id.org/aio#partiallyOverlaps
:partiallyOverlaps rdf:type owl:ObjectProperty ,
                            owl:SymmetricProperty ;
                   rdfs:domain :GeographicArea ;
                   rdfs:range :GeographicArea ;
                   rdfs:label "partially overlaps"@en ;
                   skos:definition "Areas share part of their extent but neither contains the other; a dataset on one only partly covers the other."@en .


###  https://w3id.org/aio#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :definesProblem ,
                                   :hasSystemProperty ;
                rdfs:domain :WaterEntity ;
                rdfs:range :Process ;
                rdfs:label "participates in"@en ;
                skos:definition "Relates a water entity to a process it takes part in. Inverse of has participant."@en .


###  https://w3id.org/aio#producesOutput
:producesOutput rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasModelingProperty ;
                rdfs:domain :ModelingMethod ;
                rdfs:label "produces output"@en ;
                skos:definition "Variable computed by the method and available as a result (time series or map)."@en .


###  https://w3id.org/aio#regulates
:regulates rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :influencesProcess ;
           rdfs:domain :Process ;
           rdfs:range :Process ;
           rdfs:label "regulates"@en ;
           skos:definition "Relates a process to another process whose rate it regulates."@en .


###  https://w3id.org/aio#representsProcess
:representsProcess rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasSystemProperty ;
                   rdfs:domain :FluxVariable ;
                   rdfs:range :Process ;
                   rdfs:label "represents process"@en ;
                   skos:definition "Inverse of is represented by."@en .


###  https://w3id.org/aio#representsVariable
:representsVariable rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasDataRelation ;
                    rdfs:domain :DataVariable ;
                    rdfs:range :Variable ;
                    rdfs:label "represents variable"@en ;
                    skos:definition "Relates a data variable to the system variable it provides values for (e.g. ERA5 total precipitation represents precipitation)."@en .


###  https://w3id.org/aio#requiresDerivationInput
:requiresDerivationInput rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasDataRelation ;
                         rdfs:domain :Derivation ;
                         rdfs:range :Variable ;
                         rdfs:label "requires derivation input"@en ;
                         skos:definition "Relates a derivation to a variable it needs; all of them are needed."@en .


###  https://w3id.org/aio#requiresInput
:requiresInput rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :requiresVariables ;
               rdfs:label "requires input"@en ;
               skos:definition "Relates a modelling method to a variable it needs as input."@en .


###  https://w3id.org/aio#requiresMandatoryInput
:requiresMandatoryInput rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :requiresInput ;
                        rdfs:domain :ModelingMethod ;
                        rdfs:range :Variable ;
                        rdfs:label "requires mandatory input"@en ;
                        skos:definition "Relates a method to an input without which it cannot run."@en .


###  https://w3id.org/aio#requiresObjective
:requiresObjective rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :definesProblem ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :DecisionIntent
                                               :UserQuestion
                                             )
                               ] ;
                   rdfs:range :StudyObjective ;
                   rdfs:label "requires objective"@en ;
                   skos:definition "Relates a user question or decision intent to the study objective needed to answer it."@en .


###  https://w3id.org/aio#requiresVariables
:requiresVariables rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasModelingProperty ;
                   rdfs:domain :ModelingMethod ;
                   rdfs:range :Variable ;
                   rdfs:label "requires variables"@en ;
                   skos:definition "Relates a modelling method to the variables it uses."@en .


###  https://w3id.org/aio#simulatesProcess
:simulatesProcess rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasModelingProperty ;
                  rdfs:domain :SoftwarePlatform ;
                  rdfs:range :Process ;
                  rdfs:label "simulates process"@en ;
                  skos:definition "Relates a software platform to a process it can simulate."@en .


###  https://w3id.org/aio#suppliesWaterTo
:suppliesWaterTo rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :influencesProcess ;
                 rdfs:domain :Process ;
                 rdfs:range :Process ;
                 rdfs:label "supplies water to"@en ;
                 skos:definition "Relates a process to another process to which it transfers water."@en .


###  https://w3id.org/aio#triggersProcess
:triggersProcess rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :affectsProcess ;
                 rdfs:domain :Factor ;
                 rdfs:range :Process ;
                 rdfs:label "triggers process"@en ;
                 skos:definition "Relates a factor to a process whose onset it causes (e.g. rainfall triggers runoff). Asserted only for true triggers."@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/ns/dcat#spatialResolutionInMeters
dcat:spatialResolutionInMeters rdf:type owl:DatatypeProperty ;
                               rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
                               rdfs:label "spatial resolution in meters"@en .


###  https://w3id.org/aio#isFreeOfCharge
:isFreeOfCharge rdf:type owl:DatatypeProperty ;
                rdfs:domain :SoftwarePlatform ;
                rdfs:range xsd:boolean ;
                rdfs:label "is free of charge"@en ;
                skos:definition "True if the software can be used without paying a licence fee."@en .


###  https://w3id.org/aio#isOngoing
:isOngoing rdf:type owl:DatatypeProperty ;
           rdfs:domain dcat:Dataset ;
           rdfs:range xsd:boolean ;
           rdfs:label "is ongoing"@en ;
           skos:definition "True if the dataset is still being extended in time (operational or regularly updated)."@en .


###  https://w3id.org/aio#isOpenSource
:isOpenSource rdf:type owl:DatatypeProperty ;
              rdfs:domain :SoftwarePlatform ;
              rdfs:range xsd:boolean ;
              rdfs:label "is open source"@en ;
              skos:definition "True if the source code is publicly available under an open licence or in the public domain."@en .


###  https://w3id.org/aio#spatialResolutionDegrees
:spatialResolutionDegrees rdf:type owl:DatatypeProperty ;
                          rdfs:domain :DataVariable ;
                          rdfs:range xsd:decimal ;
                          rdfs:label "spatial resolution in degrees"@en ;
                          skos:definition "Grid cell size of a gridded data variable, in decimal degrees of latitude/longitude. Complements dcat:spatialResolutionInMeters for grids defined in degrees."@en .


###  https://w3id.org/aio#valuePrecision
:valuePrecision rdf:type owl:DatatypeProperty ;
                rdfs:domain :DataVariable ;
                rdfs:range xsd:decimal ;
                rdfs:label "value precision"@en ;
                skos:definition "Smallest increment in which the values of a data variable are reported, expressed in the variable's unit (e.g. 0.1 mm)."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/terms/Location
dct:Location rdf:type owl:Class ;
             rdfs:isDefinedBy dct: ;
             rdfs:label "location"@en .


###  http://purl.org/dc/terms/PeriodOfTime
dct:PeriodOfTime rdf:type owl:Class ;
                 rdfs:isDefinedBy dct: ;
                 rdfs:label "period of time"@en .


###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class ;
          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
          rdfs:label "unit"@en .


###  http://www.w3.org/ns/dcat#Catalog
dcat:Catalog rdf:type owl:Class ;
             rdfs:label "catalog"@en .


###  http://www.w3.org/ns/dcat#Dataset
dcat:Dataset rdf:type owl:Class ;
             rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
             rdfs:label "dataset"@en .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class ;
              rdfs:label "document"@en .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:isDefinedBy <http://xmlns.com/foaf/0.1> ;
                  rdfs:label "organization"@en .


###  https://w3id.org/aio#AcquisitionMethod
:AcquisitionMethod rdf:type owl:Class ;
                   rdfs:subClassOf :DataRepresentation ;
                   rdfs:label "acquisition method"@en ;
                   skos:definition "How the underlying data were acquired."@en .


###  https://w3id.org/aio#AnthropogenicFactor
:AnthropogenicFactor rdf:type owl:Class ;
                     rdfs:subClassOf :Factor ;
                     owl:disjointWith :NaturalFactor ;
                     rdfs:label "anthropogenic factor"@en ;
                     skos:definition "A driver of human origin: land use, infrastructure, water demand, pollution, regulation."@en .


###  https://w3id.org/aio#ApplicationScale
:ApplicationScale rdf:type owl:Class ;
                  rdfs:label "application scale"@en ;
                  skos:definition "Typical size of the system the method is applied to."@en .


###  https://w3id.org/aio#ClimaticFactor
:ClimaticFactor rdf:type owl:Class ;
                rdfs:subClassOf :NaturalFactor ;
                rdfs:label "climatic factor"@en ;
                skos:definition "A natural driver related to climate and weather (e.g. rainfall, temperature)."@en .


###  https://w3id.org/aio#DataProvenance
:DataProvenance rdf:type owl:Class ;
                rdfs:subClassOf :DataRepresentation ;
                rdfs:label "data provenance"@en ;
                skos:definition "How the values of a data variable were produced."@en .


###  https://w3id.org/aio#DataRepresentation
:DataRepresentation rdf:type owl:Class ;
                    rdfs:label "data representation"@en ;
                    skos:definition "Top-level grouping for elements describing available data, such as the variables provided by datasets."@en .


###  https://w3id.org/aio#DataVariable
:DataVariable rdf:type owl:Class ;
              rdfs:subClassOf :DataRepresentation ;
              rdfs:label "data variable"@en ;
              skos:definition "A variable as delivered by a specific dataset, with its own unit, resolution and precision (e.g. ERA5 total precipitation)."@en .


###  https://w3id.org/aio#DecisionIntent
:DecisionIntent rdf:type owl:Class ;
                rdfs:subClassOf :ProblemDefinition ;
                rdfs:label "decision intent"@en ;
                skos:definition "The decision-making purpose behind a user question (e.g. assessment, comparison, impact analysis)."@en .


###  https://w3id.org/aio#Derivation
:Derivation rdf:type owl:Class ;
            rdfs:subClassOf :DataRepresentation ;
            rdfs:label "derivation"@en ;
            skos:definition "A way of obtaining a variable from other variables (pedotransfer function, lookup table, terrain analysis, ...)."@en .


###  https://w3id.org/aio#ExpectedOutput
:ExpectedOutput rdf:type owl:Class ;
                rdfs:subClassOf :ProblemDefinition ;
                rdfs:label "expected output"@en ;
                skos:definition "The result a user expects from a study, such as a map, time series or indicator."@en .


###  https://w3id.org/aio#Factor
:Factor rdf:type owl:Class ;
        rdfs:subClassOf :ProblemDefinition ;
        rdfs:label "factor"@en ;
        skos:definition "A natural or human driver that triggers or modifies hydrological processes (e.g. rainfall, urbanisation, regulation policy)."@en .


###  https://w3id.org/aio#FluxVariable
:FluxVariable rdf:type owl:Class ;
              rdfs:subClassOf :Variable ;
              rdfs:label "flux variable"@en ;
              skos:definition "A variable expressing a rate or flux of water, energy, sediment or solute (e.g. infiltration rate, discharge, evapotranspiration). Processes are represented by flux variables."@en .


###  https://w3id.org/aio#GeographicArea
:GeographicArea rdf:type owl:Class ;
                rdfs:subClassOf dct:Location ;
                rdfs:label "geographic area"@en ;
                skos:definition "A named region used to state the spatial coverage of a dataset and to match it against the user's study area."@en .


###  https://w3id.org/aio#GroundwaterBody
:GroundwaterBody rdf:type owl:Class ;
                 rdfs:subClassOf :WaterEntity ;
                 rdfs:label "groundwater body"@en ;
                 skos:definition "A water entity holding or conveying water below the land surface (e.g. aquifer)."@en .


###  https://w3id.org/aio#HydraulicMethod
:HydraulicMethod rdf:type owl:Class ;
                 rdfs:subClassOf :ModelingMethod ;
                 rdfs:label "hydraulic method"@en ;
                 skos:definition "A modelling method representing flow routing and channel or overland hydraulics."@en .


###  https://w3id.org/aio#HydraulicVariable
:HydraulicVariable rdf:type owl:Class ;
                   rdfs:subClassOf :Variable ;
                   rdfs:label "hydraulic variable"@en ;
                   skos:definition "A variable describing flow hydraulics (e.g. flow velocity, hydraulic head, shear stress)."@en .


###  https://w3id.org/aio#HydrologicalMethod
:HydrologicalMethod rdf:type owl:Class ;
                    rdfs:subClassOf :ModelingMethod ;
                    rdfs:label "hydrological method"@en ;
                    skos:definition "A modelling method representing hydrological processes such as infiltration, evapotranspiration, runoff generation or groundwater flow."@en .


###  https://w3id.org/aio#HydrologicalUnit
:HydrologicalUnit rdf:type owl:Class ;
                  rdfs:subClassOf :WaterEntity ;
                  rdfs:label "hydrological unit"@en ;
                  skos:definition "A land area defined by its drainage, such as a catchment or watershed."@en .


###  https://w3id.org/aio#HydrologicalVariable
:HydrologicalVariable rdf:type owl:Class ;
                      rdfs:subClassOf :Variable ;
                      rdfs:label "hydrological variable"@en ;
                      skos:definition "A variable describing a hydrological state or flux (e.g. precipitation, soil moisture, discharge)."@en .


###  https://w3id.org/aio#IntegratedModel
:IntegratedModel rdf:type owl:Class ;
                 rdfs:subClassOf :ModelingTool ;
                 rdfs:label "integrated model"@en ;
                 skos:definition "A modelling tool that couples several methods or compartments (e.g. surface and subsurface flow) into one model."@en .


###  https://w3id.org/aio#LandAtmosphereProcess
:LandAtmosphereProcess rdf:type owl:Class ;
                       rdfs:subClassOf :Process ;
                       rdfs:label "land-atmosphere process"@en ;
                       skos:definition "A process exchanging water or energy between the land surface and the atmosphere (evapotranspiration, snowmelt)."@en .


###  https://w3id.org/aio#LicenceCategory
:LicenceCategory rdf:type owl:Class ;
                 rdfs:label "licence category"@en ;
                 skos:definition "Access model of a software platform, used to filter recommendations by cost and openness."@en .


###  https://w3id.org/aio#ModelingDefinition
:ModelingDefinition rdf:type owl:Class ;
                    rdfs:label "modeling definition"@en ;
                    skos:definition "Top-level grouping for modelling knowledge: methods and the software platforms that implement them."@en .


###  https://w3id.org/aio#ModelingMethod
:ModelingMethod rdf:type owl:Class ;
                rdfs:subClassOf :ModelingTool ;
                rdfs:label "modeling method"@en ;
                skos:definition "A mathematical or conceptual formulation used to represent one or more processes (e.g. Green–Ampt, Saint-Venant equations)."@en .


###  https://w3id.org/aio#ModelingTool
:ModelingTool rdf:type owl:Class ;
              rdfs:subClassOf :ModelingDefinition ;
              rdfs:label "modeling tool"@en ;
              skos:definition "A means of modelling a process: either a modelling method or a software platform."@en .


###  https://w3id.org/aio#NaturalFactor
:NaturalFactor rdf:type owl:Class ;
               rdfs:subClassOf :Factor ;
               rdfs:label "natural factor"@en ;
               skos:definition "A driver of natural origin."@en .


###  https://w3id.org/aio#ParameterVariable
:ParameterVariable rdf:type owl:Class ;
                   rdfs:subClassOf :Variable ;
                   rdfs:label "parameter variable"@en ;
                   skos:altLabel "property variable"@en ;
                   skos:definition "A variable describing a mostly static property of the medium, terrain or system, used to parameterise a process (e.g. porosity, hydraulic conductivity, Manning roughness)."@en .


###  https://w3id.org/aio#PhysiographicFactor
:PhysiographicFactor rdf:type owl:Class ;
                     rdfs:subClassOf :NaturalFactor ;
                     rdfs:label "physiographic factor"@en ;
                     skos:definition "A natural driver related to the physical setting: soils, geology, terrain."@en .


###  https://w3id.org/aio#ProblemDefinition
:ProblemDefinition rdf:type owl:Class ;
                   rdfs:label "problem definition"@en ;
                   skos:definition "Top-level grouping for the elements that define a user's water-related problem: question, challenge, drivers, objective, intent, scenario and expected output."@en .


###  https://w3id.org/aio#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf :WaterSystemDefinition ;
         rdfs:label "process"@en ;
         skos:definition "A hydrological, hydraulic or transport process occurring in the water system (e.g. runoff, infiltration, sediment transport)."@en .


###  https://w3id.org/aio#Scenario
:Scenario rdf:type owl:Class ;
          rdfs:subClassOf :ProblemDefinition ;
          rdfs:label "scenario"@en ;
          skos:definition "The temporal or hypothetical frame under which a problem is studied (e.g. historical, current, future, what-if)."@en .


###  https://w3id.org/aio#SedimentTransportMethod
:SedimentTransportMethod rdf:type owl:Class ;
                         rdfs:subClassOf :ModelingMethod ;
                         rdfs:label "sediment transport method"@en ;
                         skos:definition "A modelling method representing erosion, transport or deposition of sediment."@en .


###  https://w3id.org/aio#SoftwarePlatform
:SoftwarePlatform rdf:type owl:Class ;
                  rdfs:subClassOf :ModelingTool ;
                  rdfs:label "software platform"@en ;
                  skos:definition "A software package in which modelling methods are implemented (e.g. HEC-HMS, MIKE SHE, TELEMAC)."@en .


###  https://w3id.org/aio#SpatialDimensionality
:SpatialDimensionality rdf:type owl:Class ;
                       rdfs:label "spatial dimensionality"@en ;
                       skos:definition "Number of spatial dimensions solved (hydraulics, groundwater, sediment)."@en .


###  https://w3id.org/aio#SpatialRepresentation
:SpatialRepresentation rdf:type owl:Class ;
                       rdfs:label "spatial representation"@en ;
                       skos:definition "How a method discretises space."@en .


###  https://w3id.org/aio#StateVariable
:StateVariable rdf:type owl:Class ;
               rdfs:subClassOf :Variable ;
               rdfs:label "state variable"@en ;
               skos:definition "A variable expressing a storage or condition of the system at a given time (e.g. soil moisture, snow water equivalent, hydraulic head). Processes modify state variables and may be constrained by them."@en .


###  https://w3id.org/aio#StudyObjective
:StudyObjective rdf:type owl:Class ;
                rdfs:subClassOf :ProblemDefinition ;
                rdfs:label "study objective"@en ;
                skos:definition "The type of analysis a study aims to perform (e.g. simulation, forecasting, optimisation)."@en .


###  https://w3id.org/aio#SubsurfaceProcess
:SubsurfaceProcess rdf:type owl:Class ;
                   rdfs:subClassOf :Process ;
                   rdfs:label "subsurface process"@en ;
                   skos:definition "A process acting in the unsaturated or saturated zone (recharge, groundwater flow, baseflow)."@en .


###  https://w3id.org/aio#SurfaceProcess
:SurfaceProcess rdf:type owl:Class ;
                rdfs:subClassOf :Process ;
                rdfs:label "surface process"@en ;
                skos:definition "A process acting at or on the land surface and in channels (runoff, infiltration, channel flow)."@en .


###  https://w3id.org/aio#SurfacewaterBody
:SurfacewaterBody rdf:type owl:Class ;
                  rdfs:subClassOf :WaterEntity ;
                  rdfs:label "surfacewater body"@en ;
                  skos:definition "A water entity holding or conveying water at the land surface (e.g. river, lake, stream, canal)."@en .


###  https://w3id.org/aio#TemporalMode
:TemporalMode rdf:type owl:Class ;
              rdfs:label "temporal mode"@en ;
              skos:definition "Whether a method simulates single events, continuous periods or steady state."@en .


###  https://w3id.org/aio#TemporalNature
:TemporalNature rdf:type owl:Class ;
                rdfs:label "temporal nature"@en ;
                skos:definition "How a dataset relates to time: continuous record, static snapshot, long-term average, projection or forecast."@en .


###  https://w3id.org/aio#TimeStepClass
:TimeStepClass rdf:type owl:Class ;
               rdfs:label "time-step class"@en ;
               skos:definition "Typical computational time step, aligned with dataset temporal resolution."@en .


###  https://w3id.org/aio#TransportProcess
:TransportProcess rdf:type owl:Class ;
                  rdfs:subClassOf :Process ;
                  rdfs:label "transport process"@en ;
                  skos:definition "A process transporting material carried by water (sediment, pollutants)."@en .


###  https://w3id.org/aio#UrbanSystem
:UrbanSystem rdf:type owl:Class ;
             rdfs:subClassOf :WaterEntity ;
             rdfs:label "urban system"@en ;
             skos:definition "A built-up area whose surfaces, drainage and infrastructure modify the water cycle."@en .


###  https://w3id.org/aio#UserQuestion
:UserQuestion rdf:type owl:Class ;
              rdfs:subClassOf :ProblemDefinition ;
              rdfs:label "user question"@en ;
              skos:definition "A question posed by a user about a water-related problem, from which the problem definition is derived."@en .


###  https://w3id.org/aio#Variable
:Variable rdf:type owl:Class ;
          rdfs:subClassOf :WaterSystemDefinition ;
          rdfs:label "variable"@en ;
          skos:definition "A measurable or computable characteristic of the water system used to describe, drive or parameterise a process."@en .


###  https://w3id.org/aio#WaterChallenge
:WaterChallenge rdf:type owl:Class ;
                rdfs:subClassOf :ProblemDefinition ;
                rdfs:label "water challenge"@en ;
                skos:definition "A water-related issue that motivates a study (e.g. flood, drought, water quality)."@en .


###  https://w3id.org/aio#WaterEntity
:WaterEntity rdf:type owl:Class ;
             rdfs:subClassOf :WaterSystemDefinition ;
             rdfs:label "water entity"@en ;
             skos:definition "A material part of the water system, natural or built, that takes part in hydrological processes (e.g. river, aquifer, snowpack, urban area)."@en .


###  https://w3id.org/aio#WaterSystemDefinition
:WaterSystemDefinition rdf:type owl:Class ;
                       rdfs:label "water system definition"@en ;
                       skos:definition "Top-level grouping for the physical water system: water entities, the processes acting on them and the variables describing them."@en .


#################################################################
#    Individuals
#################################################################

###  http://qudt.org/vocab/unit/DEG_C
unit:DEG_C rdf:type owl:NamedIndividual ,
