    aio:hasProvenance aio:RemoteSensingRetrieval ;
    aio:hasTimeStepClass aio:Daily ;
    aio:representsVariable aio:SoilMoisture ;
    aio:spatialResolutionDegrees "0.25"^^xsd:decimal ;
