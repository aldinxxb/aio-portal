###  https://w3id.org/aio#WashoffCoefficient
aio:WashoffCoefficient a aio:ParameterVariable ,
        owl:NamedIndividual ;
    aio:parameterizesProcess aio:PollutantTransport ;
    rdfs:label "washoff coefficient"@en ;
    skos:definition "Coefficient relating pollutant washoff to runoff rate."@en .

###  https://w3id.org/aio#WaterAbstraction
aio:WaterAbstraction a aio:FluxVariable ,
        aio:HydrologicalVariable ,
        owl:NamedIndividual ;
    aio:drivesProcess aio:ChannelFlow ,
        aio:GroundWaterFlow ;
    rdfs:label "water abstraction"@en ;
    skos:definition "Rate of water withdrawn from surface water or groundwater for human use."@en .

###  https://w3id.org/aio#WaterAvailabilty
aio:WaterAvailabilty a aio:WaterChallenge ,
        owl:NamedIndividual ;
    aio:hasPrimaryOutput aio:Hydrograph ,
        aio:WaterBalance ;
    aio:hasPrimaryProcess aio:Baseflow ,
        aio:ChannelFlow ,
        aio:GroundWaterFlow ,
        aio:Recharge ;
    aio:hasSecondaryProcess aio:Evapotranspiration ,
        aio:Infiltration ,
        aio:Runoff ,
        aio:Snowmelt ;
    aio:hasTypicalOutput aio:GroundwaterLevelSeries ,
        aio:Hydrograph ,
        aio:LowFlowIndicator ,
        aio:PiezometricMap ,
        aio:RechargeMap ,
        aio:SnowWaterEquivalentSeries ,
        aio:WaterBalance ;
    rdfs:label "water availability"@en .

###  https://w3id.org/aio#WaterBalance
aio:WaterBalance a aio:ExpectedOutput ,
        owl:NamedIndividual ;
    aio:hasOutputForm aio:IndicatorForm ;
    aio:isExpressedBy aio:ActualEvapotranspiration ,
        aio:RechargeRate ,
        aio:RunoffVolume ;
    aio:plainQuestion "Où va l'eau de pluie : rivières, nappes ou atmosphère ?"@fr ,
        "Where does the rain go: rivers, groundwater or atmosphere?"@en ;
    aio:relevantToEntity aio:Aquifer ,
        aio:Catchment ,
        aio:Lake ,
        aio:Reservoir ;
    rdfs:label "water balance"@en ;
    skos:definition "Partition of precipitation into evapotranspiration, runoff and recharge over a period."@en .

###  https://w3id.org/aio#WaterBodyDepth
aio:WaterBodyDepth a aio:ParameterVariable ,
        owl:NamedIndividual ;
    rdfs:label "water body depth"@en ;
    skos:definition "Mean depth of an inland water body."@en .

###  https://w3id.org/aio#WaterDemand
aio:WaterDemand a aio:AnthropogenicFactor ,
        aio:Factor ,
        owl:NamedIndividual ;
    aio:actsOn aio:AgriculturalLand ,
        aio:Aquifer ,
        aio:Lake ,
        aio:Reservoir ,
        aio:River ;
    aio:affectsProcess aio:Baseflow ;
    aio:isCharacterizedBy aio:WaterAbstraction ;
    aio:isKeyDriverOf aio:ClimateChange ,
        aio:Drought ,
        aio:WaterAvailabilty ;
    rdfs:label "water demand"@en .

###  https://w3id.org/aio#WaterInfrastructure
aio:WaterInfrastructure a aio:AnthropogenicFactor ,
        aio:Factor ,
        owl:NamedIndividual ;
    aio:actsOn aio:Canal ,
        aio:HydraulicInfrastructure ,
        aio:Reservoir ,
        aio:River ;
    aio:isCharacterizedBy aio:ChannelGeometry ,
        aio:ElementStructuralLineaire ,
        aio:ObstacleALecoulement ;
    aio:isKeyDriverOf aio:Flood ,
        aio:WaterAvailabilty ,
        aio:WaterQuality ;
    rdfs:label "water infrastructure"@en .

###  https://w3id.org/aio#WaterLevel
aio:WaterLevel a aio:HydraulicVariable ,
        aio:StateVariable ,
        owl:NamedIndividual ;
    aio:constrainsProcess aio:Baseflow ;
    rdfs:label "water level"@en ;
    skos:definition "Height of the water surface in a river or water body relative to a reference."@en .

###  https://w3id.org/aio#WaterLevelHydroPortail
aio:WaterLevelHydroPortail a aio:DataVariable ,
