###  https://w3id.org/aio#BoussinesqEquation
:BoussinesqEquation rdf:type owl:NamedIndividual ,
                             :HydrologicalMethod ,
                             :ModelingMethod ;
                    :acceptsOptionalInput :WaterAbstraction ;
                    :canBeImplementedIn :HEC-HMS ,
                                        :HydroGeoSphere ,
                                        :MODFLOW ;
                    :hasApplicationScale :CatchmentScale ,
                                         :HillslopeScale ;
                    :hasDimensionality :Dim1D ,
                                       :Dim2D ;
                    :hasPhysicalParameter :AquiferGeometry ,
                                          :HydraulicConductivity ,
                                          :Porosity ,
                                          :SpecificYield ;
                    :hasSpatialRepresentation :FullyDistributed ;
                    :hasTemporalMode :Continuous ;
                    :hasTypicalTimeStep :Daily ;
                    :isCalibratedAgainst :HydraulicHead ;
                    :modelsProcess :GroundWaterFlow ;
                    :producesOutput :BaseFlowContribution ,
                                    :DepthToGroundwater ,
                                    :GroundWaterLevel ,
                                    :GroundwaterFlux ,
                                    :HydraulicHead ;
                    :requiresMandatoryInput :HydraulicHead ,
                                            :RechargeRate ;
                    rdfs:label "Boussinesq equation"@en .


