                rdfs:label "classification"@en .


###  https://w3id.org/aio#ClayContentSoilGrids
:ClayContentSoilGrids rdf:type owl:NamedIndividual ,
                               :DataVariable ;
                      :hasAcquisitionMethod :ModelBased ;
                      :hasProvenance :DerivedProduct ;
                      :representsVariable :SoilTexture ;
                      dcat:spatialResolutionInMeters 250.0 ;
