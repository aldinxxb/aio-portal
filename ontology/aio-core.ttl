#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dcat:Dataset
                foaf:Organization
                :DataVariable
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DecisionIntent
                :ExpectedOutput
                :Factor
                :Process
                :Scenario
                :StudyObjective
                :UserQuestion
                :WaterChallenge
                :WaterEntity
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :FluxVariable
                :ParameterVariable
                :StateVariable
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :CatchmentScale
                        :HillslopeScale
                        :PlotScale
                        :ReachScale
                        :RegionalScale
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :ClimateProjection
                        :ForecastProduct
                        :LongTermAverage
                        :MultiEpochSnapshots
                        :RealTimeFeed
                        :StaticSnapshot
                        :TimeSeriesRecord
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :CommercialLicence
                        :FreewareClosedSource
                        :OpenSourceLicence
                        :PublicDomainSoftware
                        :RestrictedInstitutional
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Continuous
                        :EventBased
                        :SteadyState
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Daily
                        :Hourly
                        :MonthlyOrLonger
                        :SubHourly
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Dim1D
                        :Dim2D
                        :Dim3D
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :FullyDistributed
                        :Lumped
                        :SemiDistributed
                        :UnitLevelFormulation
                      )
] .


#################################################################
#    v0.7.0 additions (2026-11-10)
#    1. Driver layer: key drivers per challenge, extra factor -> process links
#    2. Climate change and land use change kept as challenges, with default drivers
#    3. Expected outputs: output forms, individuals, typical outputs per challenge/objective
#    4. Requirement layer: problem-definition values -> hard/soft rules on methods and data
#    5. Pollutant transport methods, impervious fraction use, time-step bounds, infrastructure
#    Every hydrological assertion below is a draft for expert validation.
#################################################################


#################################################################
#    1. Driver layer
#################################################################

:isKeyDriverOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isRelevantToChallenge ;
               rdfs:domain :Factor ;
               rdfs:range :WaterChallenge ;
               rdfs:label "is key driver of"@en ;
               skos:definition "Asserted by experts: the factor is one of the main drivers usually studied for this challenge. Used to list and order drivers in the portal; the inferred direct and indirect relevance covers the remaining factors."@en .

# Key drivers per challenge (expert-asserted)
:Rainfall :isKeyDriverOf :Flood , :Drought , :WaterAvailabilty , :WaterQuality .
:Temperature :isKeyDriverOf :Flood , :Drought , :WaterAvailabilty , :WaterQuality .
:ClimateChangeFactor :isKeyDriverOf :Flood , :Drought , :WaterAvailabilty .
:LandUseChangeFactor :isKeyDriverOf :Flood , :Drought , :WaterAvailabilty , :WaterQuality .
:Urbanization :isKeyDriverOf :Flood , :WaterQuality .
:Impreviousness :isKeyDriverOf :Flood .
:SoilCharacteristics :isKeyDriverOf :Flood , :Drought .
:GeologicalDriver :isKeyDriverOf :Drought , :WaterAvailabilty .
:WaterDemand :isKeyDriverOf :Drought , :WaterAvailabilty .
:RegulationPolicy :isKeyDriverOf :WaterAvailabilty , :WaterQuality .
:WaterInfrastructure :isKeyDriverOf :Flood , :WaterAvailabilty , :WaterQuality .
:PollutionSources :isKeyDriverOf :WaterQuality .

# Factor -> process links the variable chain does not produce
:WaterDemand :affectsProcess :Baseflow .
:RegulationPolicy :affectsProcess :Baseflow .
:Urbanization :affectsProcess :PollutantTransport .
:LandUseChangeFactor :affectsProcess :PollutantTransport .
:Rainfall :affectsProcess :PollutantTransport .
:Temperature :affectsProcess :PollutantTransport .

# Hydraulic infrastructure was linked to no process
:WaterInfrastructure :actsOn :HydraulicInfrastructure .
:ChannelFlow :hasParticipant :HydraulicInfrastructure .

#################################################################
#    3. Expected outputs
#################################################################

:OutputForm rdf:type owl:Class ;
            rdfs:label "output form"@en ;
            skos:definition "The form in which a result is delivered: time series, map or indicator."@en .

:TimeSeriesForm rdf:type owl:NamedIndividual , :OutputForm ;
                rdfs:label "time series"@en .
:MapForm rdf:type owl:NamedIndividual , :OutputForm ;
         rdfs:label "map"@en ;
         skos:definition "Spatially distributed result; requires a distributed or 2D/3D method."@en .
:IndicatorForm rdf:type owl:NamedIndividual , :OutputForm ;
               rdfs:label "indicator"@en ;
               skos:definition "A single value or small set of values (peak, statistic, balance term)."@en .

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :TimeSeriesForm :MapForm :IndicatorForm )
] .

:isExpressedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :ExpectedOutput ;
               rdfs:range :Variable ;
               rdfs:label "is expressed by"@en ;
               skos:definition "Variable(s) a method must produce to deliver this output."@en .

:hasOutputForm rdf:type owl:ObjectProperty ;
               rdfs:domain :ExpectedOutput ;
               rdfs:range :OutputForm ;
               rdfs:label "has output form"@en .

:hasTypicalOutput rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :definesProblem ;
                  rdfs:domain :WaterChallenge ;
                  rdfs:range :ExpectedOutput ;
                  rdfs:label "has typical output"@en ;
                  skos:definition "Outputs usually expected when studying this challenge; used to propose output options in the portal."@en .

:Hydrograph rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :Discharge ; :hasOutputForm :TimeSeriesForm ;
    skos:note "isExpressedBy lists every variable needed; the engine checks them across the whole method chain, not one method."@en ;
    rdfs:label "hydrograph"@en ;
    skos:definition "Discharge time series at an outlet or river section."@en .

:PeakFlow rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :PeakDischarge ; :hasOutputForm :IndicatorForm ;
    rdfs:label "peak flow"@en ;
    skos:definition "Maximum discharge of an event or design flood."@en .

:WaterLevelSeries rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :WaterLevel ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "water level series"@en .

:FloodExtentMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :WaterLevel ; :hasOutputForm :MapForm ;
    rdfs:label "flood extent map"@en ;
    skos:definition "Map of the flooded area and water depth."@en .

:FloodHazardMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :WaterLevel , :FlowVelocity ; :hasOutputForm :MapForm ;
    rdfs:label "flood hazard map"@en ;
    skos:definition "Map combining water depth and flow velocity into hazard classes."@en .

:LowFlowIndicator rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :Discharge ; :hasOutputForm :IndicatorForm ;
    rdfs:label "low-flow indicator"@en ;
    skos:definition "Low-flow statistic such as Q90 or minimum monthly flow, computed from a continuous discharge series."@en .

:RechargeMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :RechargeRate ; :hasOutputForm :MapForm ;
    rdfs:label "recharge map"@en .

:GroundwaterLevelSeries rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :GroundWaterLevel ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "groundwater level series"@en .

:PiezometricMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :HydraulicHead ; :hasOutputForm :MapForm ;
    rdfs:label "piezometric map"@en .

:SoilMoistureMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :SoilMoisture ; :hasOutputForm :MapForm ;
    rdfs:label "soil moisture map"@en .

:EvapotranspirationSeries rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :ActualEvapotranspiration ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "evapotranspiration series"@en .

:WaterBalance rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :ActualEvapotranspiration , :RunoffVolume , :RechargeRate ; :hasOutputForm :IndicatorForm ;
    rdfs:label "water balance"@en ;
    skos:definition "Partition of precipitation into evapotranspiration, runoff and recharge over a period."@en .

:SnowWaterEquivalentSeries rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :SnowWaterEquivalent ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "snow water equivalent series"@en .

:SedimentLoad rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :SedimentDischarge ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "sediment load"@en .

:BedEvolutionMap rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :BedElevation ; :hasOutputForm :MapForm ;
    rdfs:label "bed evolution map"@en .

:PollutantConcentrationSeries rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :PollutantConcetration ; :hasOutputForm :TimeSeriesForm ;
    rdfs:label "pollutant concentration series"@en .

:PollutantLoadEstimate rdf:type owl:NamedIndividual , :ExpectedOutput ;
    :isExpressedBy :PollutantLoad ; :hasOutputForm :IndicatorForm ;
    rdfs:label "pollutant load estimate"@en .

# Typical outputs per challenge
:Flood :hasTypicalOutput :Hydrograph , :PeakFlow , :WaterLevelSeries , :FloodExtentMap , :FloodHazardMap , :SedimentLoad .
:Drought :hasTypicalOutput :LowFlowIndicator , :SoilMoistureMap , :GroundwaterLevelSeries , :EvapotranspirationSeries , :RechargeMap .
:WaterAvailabilty :hasTypicalOutput :WaterBalance , :Hydrograph , :LowFlowIndicator , :RechargeMap , :GroundwaterLevelSeries , :PiezometricMap , :SnowWaterEquivalentSeries .
:WaterQuality :hasTypicalOutput :PollutantConcentrationSeries , :PollutantLoadEstimate , :SedimentLoad , :BedEvolutionMap .

# Typical outputs per study objective
:Forecasting :hasExpectedOutput :Hydrograph , :WaterLevelSeries , :PeakFlow .
:ThresholdDetection :hasExpectedOutput :WaterLevelSeries , :Hydrograph , :LowFlowIndicator , :GroundwaterLevelSeries .
:Estimation :hasExpectedOutput :WaterBalance , :PeakFlow , :RechargeMap , :PollutantLoadEstimate .
:Classification :hasExpectedOutput :FloodHazardMap , :SoilMoistureMap .
:Simulation :hasExpectedOutput :Hydrograph , :GroundwaterLevelSeries , :FloodExtentMap .

#################################################################
#    4. Requirement layer
#################################################################

:Requirement rdf:type owl:Class ;
             rdfs:label "requirement"@en ;
             skos:definition "A rule that a problem-definition value places on candidate methods, data or the presentation of results. Hard rules filter, soft rules change the score."@en .

:MethodRequirement rdf:type owl:Class ; rdfs:subClassOf :Requirement ;
                   rdfs:label "method requirement"@en .
:DataRequirement rdf:type owl:Class ; rdfs:subClassOf :Requirement ;
                 rdfs:label "data requirement"@en ;
                 skos:definition "Rule on the datasets proposed for time-varying inputs (forcing); static parameters such as a DEM are not affected unless stated."@en .
:PresentationRequirement rdf:type owl:Class ; rdfs:subClassOf :Requirement ;
                         rdfs:label "presentation requirement"@en ;
                         skos:definition "Rule on how results are shown (side by side, baseline vs scenario); never filters candidates."@en .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :MethodRequirement :DataRequirement :PresentationRequirement )
] .

:RequirementStrength rdf:type owl:Class ; rdfs:label "requirement strength"@en .
:Hard rdf:type owl:NamedIndividual , :RequirementStrength ;
      rdfs:label "hard"@en ; skos:definition "Candidates that fail the rule are excluded."@en .
:Soft rdf:type owl:NamedIndividual , :RequirementStrength ;
      rdfs:label "soft"@en ; skos:definition "Candidates that pass gain the weight; candidates that fail lose half of it."@en .
[ rdf:type owl:AllDifferent ; owl:distinctMembers ( :Hard :Soft ) ] .

:impliesRequirement rdf:type owl:ObjectProperty ;
                    rdfs:domain :ProblemDefinition ;
                    rdfs:range :Requirement ;
                    rdfs:label "implies requirement"@en ;
                    skos:definition "Choosing this problem-definition value adds the requirement to the request."@en .

:hasStrength rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
             rdfs:domain :Requirement ; rdfs:range :RequirementStrength ;
             rdfs:label "has strength"@en .

:allowedValue rdf:type owl:ObjectProperty ;
              rdfs:domain :Requirement ;
              rdfs:label "allowed value"@en ;
              skos:definition "For value rules: the property in onProperty must take one of these values."@en .

:allowedLiteral rdf:type owl:DatatypeProperty ;
                rdfs:domain :Requirement ;
                rdfs:label "allowed literal"@en .

:requirementWeight rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
                   rdfs:domain :Requirement ; rdfs:range xsd:decimal ;
                   rdfs:label "requirement weight"@en .

:ruleId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain :Requirement ; rdfs:range xsd:string ;
        rdfs:label "rule id"@en ;
        skos:definition "For pattern rules: identifier of the check implemented by the recommendation engine (a SPARQL template)."@en .

:onProperty rdf:type owl:AnnotationProperty ;
            rdfs:label "on property"@en ;
            skos:definition "For value rules: the property of the method or dataset that is constrained."@en .

:appliesToVariableType rdf:type owl:AnnotationProperty ;
                       rdfs:label "applies to variable type"@en ;
                       skos:definition "Restricts a data requirement to input variables of these classes."@en .

:rationale rdf:type owl:AnnotationProperty ;
           rdfs:label "rationale"@en ;
           skos:definition "Sentence shown to the user to explain the rule."@en .

# ---- Method value rules

:Req_ContinuousMode rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasTemporalMode ; :allowedValue :Continuous ; :hasStrength :Hard ;
    rdfs:label "continuous simulation required"@en ;
    :rationale "Forecasting needs continuous simulation to carry the catchment state (soil moisture, storage) from one forecast to the next."@en .

:Req_PreferContinuous rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasTemporalMode ; :allowedValue :Continuous ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "continuous simulation preferred"@en ;
    :rationale "Predictions are more reliable when the model simulates antecedent conditions continuously."@en .

:Req_TransientMode rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasTemporalMode ; :allowedValue :Continuous , :EventBased ; :hasStrength :Hard ;
    rdfs:label "transient simulation required"@en ;
    :rationale "Detecting events needs a method that simulates change in time; steady-state methods cannot."@en .

:Req_FineTimeStep rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasTypicalTimeStep ; :allowedValue :SubHourly , :Hourly ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "fine time step preferred"@en ;
    :rationale "Threshold exceedance and flash events are missed with daily or coarser time steps."@en .

:Req_FastRuns rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasSpatialRepresentation ; :allowedValue :Lumped , :SemiDistributed ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "fast runs preferred"@en ;
    :rationale "Optimization repeats many runs, so lumped or semi-distributed methods are more practical."@en .

:Req_DistributedPreferred rdf:type owl:NamedIndividual , :MethodRequirement ;
    :onProperty :hasSpatialRepresentation ; :allowedValue :FullyDistributed ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "distributed representation preferred"@en ;
    :rationale "Classification and zoning need spatially distributed results."@en .

# ---- Method pattern rules

:Req_ProducesExpectedOutput rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "produces-expected-output" ; :hasStrength :Hard ;
    rdfs:label "produces the expected output"@en ;
    :rationale "The method (or the chain of methods) must compute the variable behind the output you asked for."@en .

:Req_ProducesStateVariable rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "produces-state-variable" ; :hasStrength :Hard ;
    rdfs:label "produces a state variable"@en ;
    :rationale "Threshold detection compares a state (water level, groundwater level, soil moisture) with a threshold."@en .

:Req_SpatialOutput rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "spatially-distributed-output" ; :hasStrength :Hard ;
    rdfs:label "spatially distributed output"@en ;
    :rationale "A map requires a fully distributed or 2D/3D method."@en .

:Req_DriverIsInput rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "driver-variable-is-input" ; :hasStrength :Hard ;
    rdfs:label "driver is a method input"@en ;
    :rationale "To change a driver in a scenario, a variable characterizing it must be an input or physical parameter of the method, not only a calibrated parameter."@en .

:Req_FewCalibrationParameters rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "few-calibration-parameters" ; :hasStrength :Soft ; :requirementWeight 0.05 ;
    rdfs:label "few calibration parameters preferred"@en ;
    :rationale "Fewer calibration parameters make repeated optimization runs better constrained."@en .

:Req_PhysicallyBased rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "physical-parameters-dominant" ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "physically based method preferred"@en ;
    :rationale "Under changed conditions, calibrated conceptual parameters may no longer hold; physically meaningful parameters transfer better."@en .

:Req_CalibrationDataAvailable rdf:type owl:NamedIndividual , :MethodRequirement ;
    :ruleId "calibration-data-available" ; :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "calibration data available"@en ;
    :rationale "Operational use needs observed data to calibrate and validate the method."@en .

# ---- Data rules (forcing variables only)

:Req_ForecastData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :hasTemporalNature ; :allowedValue :ForecastProduct , :RealTimeFeed ;
    :appliesToVariableType :FluxVariable , :StateVariable ;
    :hasStrength :Soft ; :requirementWeight 0.15 ;
    rdfs:label "forecast or real-time forcing preferred"@en ;
    :rationale "Running forecasts needs forecast or real-time input data."@en .

:Req_TimeSeriesData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :hasTemporalNature ; :allowedValue :TimeSeriesRecord ;
    :appliesToVariableType :FluxVariable , :StateVariable ;
    :hasStrength :Hard ;
    rdfs:label "historical time series required"@en ;
    :rationale "Reproducing past conditions needs recorded time series for the forcing variables."@en .

:Req_OngoingData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :isOngoing ; :allowedLiteral true ;
    :appliesToVariableType :FluxVariable , :StateVariable ;
    :hasStrength :Hard ;
    rdfs:label "ongoing data required"@en ;
    :rationale "Studying current conditions needs datasets that are still updated."@en .

:Req_ObservedData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :hasProvenance ; :allowedValue :Observed , :Reanalysis ;
    :hasStrength :Soft ; :requirementWeight 0.10 ;
    rdfs:label "observed or reanalysis data preferred"@en ;
    :rationale "An assessment of the present state is more credible with observed or reanalysis data."@en .

:Req_ProjectionData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :hasTemporalNature ; :allowedValue :ClimateProjection ;
    :appliesToVariableType :FluxVariable , :StateVariable ;
    :hasStrength :Hard ;
    rdfs:label "climate projections required"@en ;
    :rationale "Future climate impacts are studied by forcing the model with climate projections."@en .

# ---- Presentation rules

:Req_SideBySide rdf:type owl:NamedIndividual , :PresentationRequirement ;
    :ruleId "side-by-side" ;
    rdfs:label "show alternatives side by side"@en ;
    :rationale "Comparison shows at least two methods with their differences."@en .

:Req_BaselineVsScenario rdf:type owl:NamedIndividual , :PresentationRequirement ;
    :ruleId "baseline-vs-scenario" ;
    rdfs:label "baseline vs scenario"@en ;
    :rationale "Impact analysis compares a baseline run with a run where the driver is changed."@en .

# ---- Which value implies which rule

:Forecasting :impliesRequirement :Req_ContinuousMode , :Req_ForecastData , :Req_CalibrationDataAvailable .
:Estimation :impliesRequirement :Req_ProducesExpectedOutput .
:ThresholdDetection :impliesRequirement :Req_ProducesStateVariable , :Req_FineTimeStep .
:Optimization :impliesRequirement :Req_FastRuns , :Req_FewCalibrationParameters .
:Classification :impliesRequirement :Req_DistributedPreferred .

:Prediction :impliesRequirement :Req_PreferContinuous .
:Comparison :impliesRequirement :Req_SideBySide .
:ImpactAnalysis :impliesRequirement :Req_DriverIsInput , :Req_BaselineVsScenario .
:Detection :impliesRequirement :Req_TransientMode , :Req_FineTimeStep .
:Assessement :impliesRequirement :Req_ObservedData .

:HistoricalScenario :impliesRequirement :Req_TimeSeriesData .
:CurrentScenario :impliesRequirement :Req_OngoingData .
:FutureScenario :impliesRequirement :Req_DriverIsInput , :Req_PhysicallyBased .
:WhatIfScenario :impliesRequirement :Req_DriverIsInput .

:ClimateChangeFactor :impliesRequirement :Req_ProjectionData .

:Hydrograph :impliesRequirement :Req_ProducesExpectedOutput .
:PeakFlow :impliesRequirement :Req_ProducesExpectedOutput .
:WaterLevelSeries :impliesRequirement :Req_ProducesExpectedOutput .
:FloodExtentMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:FloodHazardMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:LowFlowIndicator :impliesRequirement :Req_ProducesExpectedOutput .
:RechargeMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:GroundwaterLevelSeries :impliesRequirement :Req_ProducesExpectedOutput .
:PiezometricMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:SoilMoistureMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:EvapotranspirationSeries :impliesRequirement :Req_ProducesExpectedOutput .
:WaterBalance :impliesRequirement :Req_ProducesExpectedOutput .
:SnowWaterEquivalentSeries :impliesRequirement :Req_ProducesExpectedOutput .
:SedimentLoad :impliesRequirement :Req_ProducesExpectedOutput .
:BedEvolutionMap :impliesRequirement :Req_ProducesExpectedOutput , :Req_SpatialOutput .
:PollutantConcentrationSeries :impliesRequirement :Req_ProducesExpectedOutput .
:PollutantLoadEstimate :impliesRequirement :Req_ProducesExpectedOutput .

#################################################################
#    5. Methods, variables and time-step bounds
#################################################################

:WaterQualityMethod rdf:type owl:Class ;
                    rdfs:subClassOf :ModelingMethod ;
                    rdfs:label "water quality method"@en ;
                    skos:definition "Method computing the transport and transformation of dissolved or particulate pollutants."@en .

:BuildupRate rdf:type owl:NamedIndividual , :ParameterVariable ;
    :parameterizesProcess :PollutantTransport ;
    rdfs:label "buildup rate"@en ;
    skos:definition "Rate at which pollutant mass accumulates on a land surface between rain events."@en .

:WashoffCoefficient rdf:type owl:NamedIndividual , :ParameterVariable ;
    :parameterizesProcess :PollutantTransport ;
    rdfs:label "washoff coefficient"@en ;
    skos:definition "Coefficient relating pollutant washoff to runoff rate."@en .

:AdvectionDispersionEquation rdf:type owl:NamedIndividual , :WaterQualityMethod , :ModelingMethod ;
    :modelsProcess :PollutantTransport ;
    :requiresMandatoryInput :FlowVelocity , :PollutantLoad ;
    :acceptsOptionalInput :WaterTemperature , :Discharge ;
    :hasPhysicalParameter :DispersionCoefficient ;
    :hasCalibrationParameter :DecayRate ;
    :isCalibratedAgainst :PollutantConcetration , :WaterQualityParameter ;
    :producesOutput :PollutantConcetration , :PollutantLoad ;
    :hasDimensionality :Dim1D , :Dim2D , :Dim3D ;
    :hasSpatialRepresentation :FullyDistributed , :SemiDistributed ;
    :hasTemporalMode :Continuous , :EventBased ;
    :hasTypicalTimeStep :SubHourly , :Hourly ;
    :hasApplicationScale :ReachScale , :RegionalScale ;
    :canBeImplementedIn :MIKE11 , :MIKE21 , :MIKESHE , :TELEMAC , :TELEMAC-2D , :HEC-RAS , :FEFLOW , :HydroGeoSphere ;
    rdfs:label "advection–dispersion equation"@en ;
    skos:definition "Transport of a solute by advection with the flow and by dispersion, with first-order decay. Needs the flow field from a hydraulic or groundwater method."@en .

:PollutantBuildupWashoff rdf:type owl:NamedIndividual , :WaterQualityMethod , :ModelingMethod ;
    :modelsProcess :PollutantTransport ;
    :requiresMandatoryInput :Precipitation , :RunoffVolume ;
    :hasPhysicalParameter :LandCover , :ImperviousFraction ;
    :hasCalibrationParameter :BuildupRate , :WashoffCoefficient ;
    :isCalibratedAgainst :PollutantConcetration ;
    :producesOutput :PollutantLoad , :PollutantConcetration ;
    :hasSpatialRepresentation :Lumped , :SemiDistributed ;
    :hasTemporalMode :Continuous , :EventBased ;
    :hasTypicalTimeStep :SubHourly , :Hourly ;
    :hasApplicationScale :CatchmentScale ;
    :canBeImplementedIn :SWMM , :SWAT ;
    rdfs:label "pollutant buildup–washoff"@en ;
    skos:definition "Accumulation of pollutants on surfaces during dry weather and their washoff by runoff; typical for urban catchments."@en .

# Impervious fraction as a parameter of loss methods (HEC-HMS / SWMM style)
:SCS-CN :hasPhysicalParameter :ImperviousFraction .
:Green-Ampt :hasPhysicalParameter :ImperviousFraction .
:HortonInfiltrationModel :hasPhysicalParameter :ImperviousFraction .
:SoilMoistureAccounting :hasPhysicalParameter :ImperviousFraction .

# Time-step class bounds, to map dataset temporal resolution onto method time steps
:minStepHours rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
              rdfs:domain :TimeStepClass ; rdfs:range xsd:decimal ;
              rdfs:label "minimum step (hours)"@en ;
              skos:definition "Inclusive lower bound of the class, in hours."@en .
:maxStepHours rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
              rdfs:domain :TimeStepClass ; rdfs:range xsd:decimal ;
              rdfs:label "maximum step (hours)"@en ;
              skos:definition "Exclusive upper bound of the class, in hours. Absent for the open-ended class."@en .

:SubHourly :minStepHours 0.0 ; :maxStepHours 1.0 .
:Hourly :minStepHours 1.0 ; :maxStepHours 24.0 .
:Daily :minStepHours 24.0 ; :maxStepHours 720.0 .
:MonthlyOrLonger :minStepHours 720.0 .

#################################################################
#    6. Climate change and land-use change as challenges
#################################################################

:hasDefaultDriver rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :definesProblem ;
                  rdfs:domain :WaterChallenge ;
                  rdfs:range :Factor ;
                  rdfs:label "has default driver"@en ;
                  skos:definition "Driver assumed when the user picks this challenge but skips the driver step, so driver-based rules still apply."@en .

:ClimateChange :hasDefaultDriver :ClimateChangeFactor ;
               :impliesRequirement :Req_DriverIsInput , :Req_PreferProjectionData ;
               skos:definition "Impact of climate change on water resources and hydrological extremes."@en .
:LandUseChange :hasDefaultDriver :LandUseChangeFactor ;
               :impliesRequirement :Req_DriverIsInput ;
               skos:definition "Impact of changes in land cover and land use (urbanization, agriculture, deforestation) on the water cycle."@en .

:ClimateChangeFactor :isKeyDriverOf :ClimateChange .
:Temperature :isKeyDriverOf :ClimateChange .
:Rainfall :isKeyDriverOf :ClimateChange .
:WaterDemand :isKeyDriverOf :ClimateChange .
:LandUseChangeFactor :isKeyDriverOf :LandUseChange .
:Urbanization :isKeyDriverOf :LandUseChange .
:Impreviousness :isKeyDriverOf :LandUseChange .
:SoilCharacteristics :isKeyDriverOf :LandUseChange .
:Rainfall :isKeyDriverOf :LandUseChange .

:ClimateChange :hasTypicalOutput :Hydrograph , :LowFlowIndicator , :WaterBalance , :RechargeMap , :EvapotranspirationSeries , :SnowWaterEquivalentSeries , :PeakFlow .
:LandUseChange :hasTypicalOutput :Hydrograph , :PeakFlow , :WaterBalance , :RechargeMap , :EvapotranspirationSeries , :SedimentLoad , :PollutantLoadEstimate .

:Req_PreferProjectionData rdf:type owl:NamedIndividual , :DataRequirement ;
    :onProperty :hasTemporalNature ; :allowedValue :ClimateProjection ;
    :appliesToVariableType :FluxVariable , :StateVariable ;
    :hasStrength :Soft ; :requirementWeight 0.15 ;
    rdfs:label "climate projections preferred"@en ;
    :rationale "Climate change impacts are usually studied with climate projections; trend analysis on historical records is also possible."@en .

