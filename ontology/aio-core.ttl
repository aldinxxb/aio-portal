                      dct:spatial :MetropolitanFrance ;
                      dct:temporal :Period_DRIASLesFutursDeLeau ;
                      dcat:landingPage <https://www.drias-eau.fr> ,
                                       <https://www.drias-eau.fr/accompagnement/getMenu> ;
                      :containsVariable :CumulativeEffectiveRainfallExplore2 ,
