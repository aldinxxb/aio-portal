###  https://w3id.org/aio#DiffusiveWave2D
aio:DiffusiveWave2D a aio:HydraulicMethod ,
        aio:ModelingMethod ,
        owl:NamedIndividual ;
    aio:acceptsOptionalInput aio:EffectiveRainfall ,
        aio:Precipitation ,
        aio:WaterLevel ;
    aio:canBeImplementedIn aio:HEC-HMS ,
        aio:HEC-RAS ,
        aio:MIKESHE ;
    aio:hasApplicationScale aio:CatchmentScale ,
        aio:ReachScale ;
    aio:hasDimensionality aio:Dim2D ;
    aio:hasPhysicalParameter aio:ManningRoughnessCoefficient ,
        aio:TerrainSlope ;
    aio:hasSpatialRepresentation aio:FullyDistributed ;
    aio:hasTemporalMode aio:Continuous ,
        aio:EventBased ;
    aio:hasTypicalTimeStep aio:SubHourly ;
    aio:isAlternativeTo aio:Clark-UH ,
        aio:ConceptualRoutingReservoir ,
        aio:GR4Jmodel ,
        aio:KinematicWave ,
        aio:LinearReservoir ,
        aio:ManningsEquation ,
        aio:ModClark ,
        aio:Navier-StokesSimplified ,
        aio:NonLinearReservoir ,
        aio:SCS-UH ,
        aio:Saint-VenantEquations1D ,
        aio:ShallowWaterEquations2D ;
    aio:isCalibratedAgainst aio:HistoricalFloodLevel ,
        aio:WaterLevel ;
    aio:modelsProcess aio:ChannelFlow ,
        aio:Runoff ;
    aio:producesOutput aio:Discharge ,
        aio:FlowVelocity ,
        aio:PeakDischarge ,
        aio:WaterLevel ;
    aio:requiresMandatoryInput aio:DTM ,
        aio:Discharge ;
    aio:supportsTimeStep aio:SubHourly ;
    rdfs:label "2D diffusive wave"@en .

