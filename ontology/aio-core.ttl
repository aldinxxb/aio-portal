#################################################################

:hasPrimaryOutput rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasTypicalOutput ;
                  rdfs:label "has primary output"@en ;
                  skos:definition "The output most often expected for this challenge; proposed first and pre-selected for non-expert users."@en .

:relevantToEntity rdf:type owl:ObjectProperty ;
                  rdfs:domain :ExpectedOutput ;
                  rdfs:range :WaterEntity ;
                  rdfs:label "relevant to entity"@en ;
