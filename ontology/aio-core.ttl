                                        :SolidPrecipitationExplore2 ;
                      :hasTemporalNature :ClimateProjection ;
                      :isOngoing "false"^^xsd:boolean ;
                      rdfs:label "DRIAS – Les futurs de l'eau"@fr ;
                      skos:altLabel "Catalogue de données de simulations hydrologiques"@fr ;
                      skos:definition "Portal of the Explore2 hydrological projections for France: simulated river discharge indicators and water-balance variables under climate scenarios."@en ;
                      skos:note "Explore2: daily series 1976–2100, reference period 1976–2005, RCP2.6/4.5/8.5."@en .


