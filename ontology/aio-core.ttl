###  https://w3id.org/aio#TemperatureIndexMethod
:TemperatureIndexMethod rdf:type owl:NamedIndividual ,
                                 :HydrologicalMethod ,
                                 :ModelingMethod ;
                        :acceptsOptionalInput :SnowCover ,
                                              :SnowDepth ,
                                              :SnowWaterEquivalent ;
                        :canBeImplementedIn :HEC-HMS ,
                                            :ISBA ,
                                            :MIKESHE ,
                                            :SWAT ;
                        :hasApplicationScale :CatchmentScale ,
                                             :RegionalScale ;
                        :hasCalibrationParameter :DegreeDayFactor ;
                        :hasSpatialRepresentation :FullyDistributed ,
                                                  :Lumped ,
                                                  :SemiDistributed ;
                        :hasTemporalMode :Continuous ;
                        :hasTypicalTimeStep :Daily ;
                        :isCalibratedAgainst :Discharge ,
                                             :SnowCover ,
                                             :SnowWaterEquivalent ;
                        :modelsProcess :Snowmelt ;
                        :producesOutput :SnowCover ,
                                        :SnowWaterEquivalent ,
                                        :SnowmeltAmount ;
                        :requiresMandatoryInput :AirTemperature ,
                                                :Precipitation ;
                        rdfs:label "temperature-index (degree-day) snowmelt method"@en ;
                        skos:altLabel "Degree Day Snowmelt"@en ,
                                      "Temperature Index Snowmelt"@en ,
                                      "degree-day method"@en ,
                                      "temperature index"@en ,
                                      "temperature index method"@en ;
                        skos:definition "Snowmelt computed as a degree-day factor times the air temperature above a threshold; snow accumulates from precipitation below a rain/snow temperature threshold. Variants add cold content and antecedent temperature index (e.g. HEC-HMS temperature index)."@en .


