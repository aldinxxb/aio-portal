                  :hasTemporalMode :Continuous ;
                  :hasTypicalTimeStep :Hourly ,
                                      :SubHourly ;
                  :isCalibratedAgainst :SoilMoisture ;
                  :modelsProcess :GroundWaterFlow ,
                                 :Infiltration ;
