###  https://w3id.org/aio#ClimateChange
:ClimateChange rdf:type owl:NamedIndividual ,
                        :WaterChallenge ;
               :hasPrimaryProcess :Evapotranspiration ,
                                  :Recharge ,
                                  :Snowmelt ;
               :hasSecondaryProcess :Baseflow ,
                                    :ChannelFlow ,
                                    :GroundWaterFlow ,
                                    :Infiltration ,
                                    :Runoff ;
               rdfs:label "climate change"@en ;
               skos:related :ClimateChangeFactor .


###  https://w3id.org/aio#ClimateChangeFactor
:ClimateChangeFactor rdf:type owl:NamedIndividual ,
                              :ClimaticFactor ;
                     :actsOn :Aquifer ,
                             :Catchement ,
                             :River ,
                             :SnowPack ;
                     :definedUnderScenario :FutureScenario ;
                     :isCharacterizedBy :AirTemperature ,
                                        :PotentialEvapotranspiration ,
                                        :Precipitation ,
                                        :SnowWaterEquivalent ;
                     rdfs:label "climate change (driver)"@en ;
                     skos:definition "Long-term change in climate acting as a driver on hydrological processes; studied through future climate scenarios."@en ;
                     skos:related :ClimateChange .


