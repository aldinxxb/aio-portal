#  AIO core ontology 0.9.0. Generated by ontology/tools/split_into_modules.py from AIO 0.8.0;
#  edit it in Protege like any ontology file.

###  https://w3id.org/aio
<https://w3id.org/aio> a owl:Ontology ;
    dct:description "Core of the AIO ontology: the problem a user wants to solve (water challenge, objective, expected output), the water system (water entities, processes, variables), the modelling knowledge (methods, software platforms) and the representation of data (datasets, data variables, provenance, derivations), with the value sets that describe them."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-20"^^xsd:date ;
    dct:title "AIO ontology - core"@en ;
    owl:priorVersion <https://w3id.org/aio/0.8.0> ;
    owl:versionIRI <https://w3id.org/aio/0.9.0> ;
    owl:versionInfo "0.9.0" ;
    vann:preferredNamespacePrefix "aio" ;
    vann:preferredNamespaceUri "https://w3id.org/aio#" .

