#################################################################
#    Individuals
#################################################################

###  https://w3id.org/aio#AgriculturalLand
aio:AgriculturalLand skos:closeMatch obo:ENVO_01000892 .

###  https://w3id.org/aio#AlluvialAquifer
aio:AlluvialAquifer skos:broadMatch obo:ENVO_00012408 .

###  https://w3id.org/aio#Aquifer
aio:Aquifer skos:exactMatch <http://sweetontology.net/realmHydro/Aquifer> ,
        obo:ENVO_00012408 .

###  https://w3id.org/aio#Atmosphere
aio:Atmosphere skos:exactMatch <http://sweetontology.net/realm/Atmosphere> ,
        obo:ENVO_01000267 .

###  https://w3id.org/aio#Baseflow
aio:Baseflow skos:exactMatch <http://sweetontology.net/phenHydro/BaseFlow> .

###  https://w3id.org/aio#Canal
aio:Canal skos:exactMatch <http://sweetontology.net/realmHydroBody/Canal> ,
        obo:ENVO_00000014 .

###  https://w3id.org/aio#Catchment
aio:Catchment skos:exactMatch <http://sweetontology.net/realmLandFluvial/Catchment> ,
        obo:ENVO_00000291 .

###  https://w3id.org/aio#ChannelFlow
aio:ChannelFlow skos:broadMatch obo:ENVO_01000982 ;
    skos:closeMatch <http://sweetontology.net/phenHydro/Streamflow> .

###  https://w3id.org/aio#ClimateChange
aio:ClimateChange skos:exactMatch <http://sweetontology.net/phenPlanetClimate/ClimateChange> .

###  https://w3id.org/aio#DataVariable
aio:DataVariable rdfs:subClassOf iop:Variable .

###  https://w3id.org/aio#Drought
aio:Drought skos:exactMatch <http://sweetontology.net/phenPlanetClimate/Drought> ,
        obo:ENVO_1000745 .

###  https://w3id.org/aio#Estuary
aio:Estuary skos:exactMatch <http://sweetontology.net/realmHydroBody/Estuary> ,
        obo:ENVO_00000045 .

###  https://w3id.org/aio#Evapotranspiration
aio:Evapotranspiration skos:exactMatch obo:ENVO_02500033 .

###  https://w3id.org/aio#Flood
aio:Flood skos:exactMatch <http://sweetontology.net/phenHydro/Flood> ,
        obo:ENVO_01000710 .

###  https://w3id.org/aio#Floodplain
aio:Floodplain skos:exactMatch <http://sweetontology.net/realmLandFluvial/FloodPlain> ,
        obo:ENVO_00000255 .

###  https://w3id.org/aio#Glacier
aio:Glacier skos:exactMatch <http://sweetontology.net/realmCryo/Glacier> ,
        obo:ENVO_00000133 .

###  https://w3id.org/aio#GroundWaterFlow
aio:GroundWaterFlow skos:exactMatch obo:ENVO_01001632 .

###  https://w3id.org/aio#hasParticipant
aio:hasParticipant rdfs:subPropertyOf obo:RO_0000057 .

###  https://w3id.org/aio#HydraulicConductivity
aio:HydraulicConductivity skos:exactMatch <http://sweetontology.net/propConductivity/HydraulicConductivity> .

###  https://w3id.org/aio#HydraulicInfrastructure
aio:HydraulicInfrastructure skos:broadMatch <http://sweetontology.net/matrEquipment/Infrastructure> ;
    skos:narrowMatch obo:ENVO_00000074 ,
        obo:ENVO_00000178 ,
        obo:ENVO_00000535 .

###  https://w3id.org/aio#Infiltration
aio:Infiltration skos:exactMatch <http://sweetontology.net/phenHydro/Infiltration> ,
        obo:ENVO_06105230 .

###  https://w3id.org/aio#KarstAquifer
aio:KarstAquifer skos:broadMatch obo:ENVO_00012408 ;
    skos:related <http://sweetontology.net/phenGeolGeomorphology/Karst> .

###  https://w3id.org/aio#Lake
aio:Lake skos:exactMatch <http://sweetontology.net/realmHydroBody/Lake> ,
        obo:ENVO_00000020 .

###  https://w3id.org/aio#participatesIn
aio:participatesIn rdfs:subPropertyOf obo:RO_0000056 .

###  https://w3id.org/aio#Porosity
aio:Porosity skos:exactMatch <http://sweetontology.net/propFraction/Porosity> .

###  https://w3id.org/aio#Process
aio:Process rdfs:subClassOf obo:BFO_0000015 .

###  https://w3id.org/aio#Recharge
aio:Recharge skos:exactMatch <http://sweetontology.net/phenHydro/Recharge> .

###  https://w3id.org/aio#Reservoir
aio:Reservoir skos:exactMatch <http://sweetontology.net/realmHydroBody/Reservoir> ,
        obo:ENVO_00000025 .

###  https://w3id.org/aio#River
aio:River skos:closeMatch <http://sweetontology.net/realmHydroBody/Stream> ,
        obo:ENVO_00000023 ;
    skos:exactMatch <http://sweetontology.net/realmHydroBody/River> ,
        obo:ENVO_00000022 .

###  https://w3id.org/aio#Runoff
aio:Runoff skos:closeMatch obo:ENVO_06105211 ;
    skos:exactMatch <http://sweetontology.net/phenHydro/Runoff> .

###  https://w3id.org/aio#Snowmelt
aio:Snowmelt skos:exactMatch obo:ENVO_01000719 .

###  https://w3id.org/aio#SnowPack
aio:SnowPack skos:exactMatch obo:ENVO_03000116 .

###  https://w3id.org/aio#SoftwarePlatform
aio:SoftwarePlatform rdfs:subClassOf schema:SoftwareApplication .

###  https://w3id.org/aio#UnsaturatedZone
aio:UnsaturatedZone skos:exactMatch <http://sweetontology.net/realmHydro/VadoseZone> ,
        obo:ENVO_00000328 .

###  https://w3id.org/aio#UrbanArea
aio:UrbanArea skos:closeMatch obo:ENVO_01000249 ;
    skos:exactMatch <http://sweetontology.net/humanJurisdiction/UrbanArea> .

###  https://w3id.org/aio#Urbanization
aio:Urbanization skos:exactMatch <http://sweetontology.net/humanCommerce/Urbanization> .

###  https://w3id.org/aio#Variable
aio:Variable rdfs:subClassOf sosa:ObservableProperty .

###  https://w3id.org/aio#WaterEntity
aio:WaterEntity rdfs:subClassOf obo:BFO_0000040 .

###  https://w3id.org/aio#WaterQuality
aio:WaterQuality skos:closeMatch <http://sweetontology.net/phenEnvirImpact/WaterQuality> .

###  https://w3id.org/aio#Wetland
aio:Wetland skos:closeMatch obo:ENVO_00000043 ;
    skos:exactMatch <http://sweetontology.net/realmHydroBody/Wetland> .
