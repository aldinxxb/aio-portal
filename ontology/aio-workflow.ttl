@prefix aio: <https://w3id.org/aio#> .
@prefix aiowf: <https://w3id.org/aio/workflow#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#  AIO extension: model composition 0.9.0. Imports the core.

###  https://w3id.org/aio/workflow
<https://w3id.org/aio/workflow> a owl:Ontology ;
    dct:description "How methods are assembled into a model: the component roles a method can fill, the interfaces through which roles exchange variables, chain templates and their slots, coupling types. Used by the recommendation to build and check workflows."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-20"^^xsd:date ;
    dct:title "AIO extension - model composition"@en ;
    owl:imports <https://w3id.org/aio> ;
    owl:versionIRI <https://w3id.org/aio/workflow/0.9.0> ;
    owl:versionInfo "0.9.0" ;
    vann:preferredNamespacePrefix "aiowf" ;
    vann:preferredNamespaceUri "https://w3id.org/aio/workflow#" .

#################################################################
#    Object properties
#################################################################

###  https://w3id.org/aio/workflow#canFeed
aiowf:canFeed a owl:ObjectProperty ;
    rdfs:domain aio:ModelingMethod ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "can feed"@en ;
    rdfs:range aio:ModelingMethod ;
    skos:definition "Method A can pass its output to method B: A fills a role that feeds B's role through a role interface, A produces the exchanged variable, neither method already plays the other's role, B takes the variable (or the input it replaces) as an input, both share a compatible time step (A at least as fine as B), and, where the interface requires it, both have the same spatial structure. Materialised by the build script."@en .

###  https://w3id.org/aio/workflow#deliversOutput
aiowf:deliversOutput a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "delivers output"@en ;
    rdfs:range aio:ExpectedOutput ;
    skos:definition "Expected output that a chain built on this template can produce."@en .

###  https://w3id.org/aio/workflow#exchangesVariable
aiowf:exchangesVariable a owl:ObjectProperty ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "exchanges variable"@en ;
    rdfs:range aio:Variable ;
    skos:definition "Variable passed through the interface."@en .

###  https://w3id.org/aio/workflow#feedsRole
aiowf:feedsRole a owl:ObjectProperty ;
    owl:propertyChainAxiom _:node11 ;
    rdfs:domain aiowf:ComponentRole ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "feeds role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Role A feeds role B through at least one role interface (inferred: isSourceOfInterface ∘ toRole)."@en .

###  https://w3id.org/aio/workflow#fillsRole
aiowf:fillsRole a owl:ObjectProperty ;
    rdfs:domain aio:ModelingMethod ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "fills role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Component role that the method can play in a model structure."@en .

###  https://w3id.org/aio/workflow#fromRole
aiowf:fromRole a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    owl:inverseOf aiowf:isSourceOfInterface ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "from role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Role that provides the exchanged variable."@en .

###  https://w3id.org/aio/workflow#hasSlot
aiowf:hasSlot a owl:ObjectProperty ;
    rdfs:domain aiowf:ChainTemplate ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "has slot"@en ;
    rdfs:range aiowf:ChainSlot ;
    skos:definition "Slot of the template."@en .

###  https://w3id.org/aio/workflow#hasTypicalCoupling
aiowf:hasTypicalCoupling a owl:ObjectProperty ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "has typical coupling"@en ;
    rdfs:range aiowf:CouplingType ;
    skos:definition "Usual coupling type for this interface."@en .

###  https://w3id.org/aio/workflow#isSourceOfInterface
aiowf:isSourceOfInterface a owl:ObjectProperty ;
    rdfs:domain aiowf:ComponentRole ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "is source of interface"@en ;
    rdfs:range aiowf:RoleInterface ;
    skos:definition "Inverse of from role."@en .

###  https://w3id.org/aio/workflow#servesChallenge
aiowf:servesChallenge a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "serves challenge"@en ;
    rdfs:range aio:WaterChallenge ;
    skos:definition "Water challenge this template or chain is typically used for."@en .

###  https://w3id.org/aio/workflow#slotRole
aiowf:slotRole a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiowf:ChainSlot ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "slot role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Role to be filled in this slot."@en .

###  https://w3id.org/aio/workflow#substitutesInput
aiowf:substitutesInput a owl:ObjectProperty ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "substitutes input"@en ;
    rdfs:range aio:Variable ;
    skos:definition "Input of the receiving method that the exchanged variable replaces (e.g. throughfall replaces precipitation), so it needs no dataset."@en .

###  https://w3id.org/aio/workflow#toRole
aiowf:toRole a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "to role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Role that receives the exchanged variable."@en .

#################################################################
#    Data properties
#################################################################

###  https://w3id.org/aio/workflow#hasInseparableRoles
aiowf:hasInseparableRoles a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain aio:ModelingMethod ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "has inseparable roles"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "For a method that fills several component roles. True: the roles are one calculation and are always held together (the method is a package: it is added to a chain with all its roles, or not at all). False: the method is used for one role at a time, and may hold a single role in a chain. Not stated on methods with a single role."@en .

###  https://w3id.org/aio/workflow#isMandatorySlot
aiowf:isMandatorySlot a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain aiowf:ChainSlot ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "is mandatory slot"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True if a chain must fill this slot."@en .

###  https://w3id.org/aio/workflow#requiresMatchingSpatialRepresentation
aiowf:requiresMatchingSpatialRepresentation a owl:DatatypeProperty ;
    rdfs:domain aiowf:RoleInterface ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "requires matching spatial representation"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the exchanged field must have the same spatial structure on both sides (e.g. gridded excess rainfall for a gridded transform)."@en .

###  https://w3id.org/aio/workflow#slotOrder
aiowf:slotOrder a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain aiowf:ChainSlot ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "slot order"@en ;
    rdfs:range xsd:integer ;
    skos:definition "Position of the slot from upstream (1) to downstream."@en .

#################################################################
#    Classes
#################################################################

###  https://w3id.org/aio/workflow#ChainSlot
aiowf:ChainSlot a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "chain slot"@en ;
    skos:definition "Position of a component role in a chain template."@en .

###  https://w3id.org/aio/workflow#ChainTemplate
aiowf:ChainTemplate a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "chain template"@en ;
    skos:definition "Standard model structure for a kind of study: an ordered list of role slots, some mandatory."@en .

###  https://w3id.org/aio/workflow#ComponentRole
aiowf:ComponentRole a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "component role"@en ;
    skos:definition "A slot in a model structure (loss, transform, routing, …). Methods fill roles; two methods filling the same role are alternatives, methods in roles linked by a role interface can be chained."@en .

###  https://w3id.org/aio/workflow#CouplingType
aiowf:CouplingType a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "coupling type"@en ;
    skos:definition "How two components exchange information."@en .

###  https://w3id.org/aio/workflow#RoleInterface
aiowf:RoleInterface a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/workflow> ;
    rdfs:label "role interface"@en ;
    skos:definition "n-ary link stating that the output of one component role feeds another, which variable is exchanged and how they are usually coupled."@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/aio#AdvectionDispersionEquation
aio:AdvectionDispersionEquation aiowf:fillsRole aiowf:Role_SoluteTransport .

###  https://w3id.org/aio#BoussinesqEquation
aio:BoussinesqEquation aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:ConductionAdvectionThermalEquation ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_GroundwaterFlow .

###  https://w3id.org/aio#ChannelElements1D
aio:ChannelElements1D aiowf:canFeed aio:DiffusiveWave2D ,
        aio:ManningsEquation ,
        aio:Navier-StokesSimplified ,
        aio:ShallowWaterEquations2D ;
    aiowf:fillsRole aiowf:Role_ChannelRouting .

###  https://w3id.org/aio#Clark-UH
aio:Clark-UH aiowf:canFeed aio:ChannelElements1D ,
        aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_RunoffTransform .

###  https://w3id.org/aio#ConceptualGroundwaterReservoir
aio:ConceptualGroundwaterReservoir aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Baseflow .

###  https://w3id.org/aio#ConceptualRoutingReservoir
aio:ConceptualRoutingReservoir aiowf:canFeed aio:ManningsEquation ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_ChannelRouting ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#ConductionAdvectionThermalEquation
aio:ConductionAdvectionThermalEquation aiowf:fillsRole aiowf:Role_HeatTransport .

###  https://w3id.org/aio#ConstantBF
aio:ConstantBF aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Baseflow .

###  https://w3id.org/aio#DarcyEquation3D
aio:DarcyEquation3D aiowf:canFeed aio:AdvectionDispersionEquation ,
        aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:ConductionAdvectionThermalEquation ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_GroundwaterFlow .

###  https://w3id.org/aio#DiffusiveWave2D
aio:DiffusiveWave2D aiowf:canFeed aio:AdvectionDispersionEquation ,
        aio:ChannelElements1D ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Hydraulics ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#EmpiricalCropCoefficients
aio:EmpiricalCropCoefficients aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#EnergyEquation
aio:EnergyEquation aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#EngelundHansen
aio:EngelundHansen aiowf:canFeed aio:ExnerEquation ;
    aiowf:fillsRole aiowf:Role_SedimentTransport .

###  https://w3id.org/aio#ExnerEquation
aio:ExnerEquation aiowf:fillsRole aiowf:Role_Morphology .

###  https://w3id.org/aio#FiniteDifferenceGroundwaterFlow
aio:FiniteDifferenceGroundwaterFlow aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:ConductionAdvectionThermalEquation ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_GroundwaterFlow .

###  https://w3id.org/aio#FiniteVolumeSedimentTransport
aio:FiniteVolumeSedimentTransport aiowf:fillsRole aiowf:Role_Morphology ,
        aiowf:Role_SedimentTransport ;
    aiowf:hasInseparableRoles "true"^^xsd:boolean .

###  https://w3id.org/aio#GashAnalyticalModel
aio:GashAnalyticalModel aiowf:canFeed aio:GR4Jmodel ,
        aio:LayeredSoilWaterBudget ,
        aio:SCS-CN ,
        aio:SoilMoistureAccounting ,
        aio:VIC-RunoffGeneration ;
    aiowf:fillsRole aiowf:Role_Interception .

###  https://w3id.org/aio#GR-likeConceptualETreduction
aio:GR-likeConceptualETreduction aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#GR4Jmodel
aio:GR4Jmodel aiowf:canFeed aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:PollutantBuildupWashoff ;
    aiowf:fillsRole aiowf:Role_Baseflow ,
        aiowf:Role_ExcessRainfall ,
        aiowf:Role_RunoffTransform ,
        aiowf:Role_SoilWaterBudget ;
    aiowf:hasInseparableRoles "true"^^xsd:boolean .

###  https://w3id.org/aio#Green-Ampt
aio:Green-Ampt aiowf:canFeed aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:KinematicWave ,
        aio:LinearReservoir ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:SCS-UH ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall .

###  https://w3id.org/aio#HargeavesMethod
aio:HargeavesMethod aiowf:canFeed aio:EmpiricalCropCoefficients ,
        aio:GR-likeConceptualETreduction ,
        aio:GR4Jmodel ,
        aio:GashAnalyticalModel ,
        aio:KristenJensen ,
        aio:LayeredSoilWaterBudget ,
        aio:MoistureContentThresholds ,
        aio:RootzoneStress ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_PET .

###  https://w3id.org/aio#HortonInfiltrationModel
aio:HortonInfiltrationModel aiowf:canFeed aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:KinematicWave ,
        aio:LinearReservoir ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:SCS-UH ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall .

###  https://w3id.org/aio#KinematicWave
aio:KinematicWave aiowf:canFeed aio:DiffusiveWave2D ,
        aio:ManningsEquation ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ,
        aio:ShallowWaterEquations2D ;
    aiowf:fillsRole aiowf:Role_ChannelRouting ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#KristenJensen
aio:KristenJensen aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#LayeredSoilWaterBudget
aio:LayeredSoilWaterBudget aiowf:canFeed aio:BoussinesqEquation ,
        aio:ConceptualGroundwaterReservoir ,
        aio:DarcyEquation3D ,
        aio:FiniteDifferenceGroundwaterFlow ,
        aio:Green-Ampt ,
        aio:KristenJensen ,
        aio:MoistureContentThresholds ,
        aio:PhilipsEquation ,
        aio:RootzoneStress ,
        aio:SCS-CN ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_SoilWaterBudget .

###  https://w3id.org/aio#LinearReservoir
aio:LinearReservoir aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Baseflow ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#ManningsEquation
aio:ManningsEquation aiowf:canFeed aio:AdvectionDispersionEquation ;
    aiowf:fillsRole aiowf:Role_Hydraulics .

###  https://w3id.org/aio#MeyerPeterMuller
aio:MeyerPeterMuller aiowf:canFeed aio:ExnerEquation ;
    aiowf:fillsRole aiowf:Role_SedimentTransport .

###  https://w3id.org/aio#ModClark
aio:ModClark aiowf:canFeed aio:ChannelElements1D ,
        aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_RunoffTransform .

###  https://w3id.org/aio#MoistureContentThresholds
aio:MoistureContentThresholds aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#Muskingum-Cunge
aio:Muskingum-Cunge aiowf:canFeed aio:DiffusiveWave2D ,
        aio:ManningsEquation ,
        aio:Navier-StokesSimplified ,
        aio:ShallowWaterEquations2D ;
    aiowf:fillsRole aiowf:Role_ChannelRouting .

###  https://w3id.org/aio#Navier-StokesSimplified
aio:Navier-StokesSimplified aiowf:canFeed aio:AdvectionDispersionEquation ,
        aio:EngelundHansen ,
        aio:FiniteVolumeSedimentTransport ,
        aio:MeyerPeterMuller ;
    aiowf:fillsRole aiowf:Role_Hydraulics .

###  https://w3id.org/aio#NonLinearReservoir
aio:NonLinearReservoir aiowf:canFeed aio:ChannelElements1D ,
        aio:ConceptualRoutingReservoir ,
        aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Baseflow ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#Penman-Monteih
aio:Penman-Monteih aiowf:canFeed aio:EmpiricalCropCoefficients ,
        aio:GR-likeConceptualETreduction ,
        aio:GR4Jmodel ,
        aio:GashAnalyticalModel ,
        aio:KristenJensen ,
        aio:LayeredSoilWaterBudget ,
        aio:MoistureContentThresholds ,
        aio:RootzoneStress ,
        aio:RutterModel ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_PET .

###  https://w3id.org/aio#PhilipsEquation
aio:PhilipsEquation aiowf:canFeed aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:KinematicWave ,
        aio:LinearReservoir ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:SCS-UH ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall .

###  https://w3id.org/aio#PollutantBuildupWashoff
aio:PollutantBuildupWashoff aiowf:canFeed aio:AdvectionDispersionEquation ;
    aiowf:fillsRole aiowf:Role_PollutantLoading .

###  https://w3id.org/aio#Priestly-TaylorEstimates
aio:Priestly-TaylorEstimates aiowf:canFeed aio:EmpiricalCropCoefficients ,
        aio:GR-likeConceptualETreduction ,
        aio:GR4Jmodel ,
        aio:GashAnalyticalModel ,
        aio:KristenJensen ,
        aio:LayeredSoilWaterBudget ,
        aio:MoistureContentThresholds ,
        aio:RootzoneStress ,
        aio:RutterModel ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_PET .

###  https://w3id.org/aio#RichardsEquation
aio:RichardsEquation aiowf:canFeed aio:BoussinesqEquation ,
        aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:DarcyEquation3D ,
        aio:DiffusiveWave2D ,
        aio:FiniteDifferenceGroundwaterFlow ,
        aio:KinematicWave ,
        aio:KristenJensen ,
        aio:LinearReservoir ,
        aio:ModClark ,
        aio:MoistureContentThresholds ,
        aio:NonLinearReservoir ,
        aio:RootzoneStress ,
        aio:SCS-UH ,
        aio:ShallowWaterEquations2D ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall ,
        aiowf:Role_SoilWaterBudget ;
    aiowf:hasInseparableRoles "true"^^xsd:boolean .

###  https://w3id.org/aio#RootzoneStress
aio:RootzoneStress aiowf:canFeed aio:LayeredSoilWaterBudget ,
        aio:RichardsEquation ,
        aio:SoilMoistureAccounting ;
    aiowf:fillsRole aiowf:Role_ActualET .

###  https://w3id.org/aio#RutterModel
aio:RutterModel aiowf:canFeed aio:GR4Jmodel ,
        aio:Green-Ampt ,
        aio:HortonInfiltrationModel ,
        aio:LayeredSoilWaterBudget ,
        aio:PhilipsEquation ,
        aio:RichardsEquation ,
        aio:SCS-CN ,
        aio:SoilMoistureAccounting ,
        aio:VIC-RunoffGeneration ;
    aiowf:fillsRole aiowf:Role_Interception .

###  https://w3id.org/aio#Saint-VenantEquations1D
aio:Saint-VenantEquations1D aiowf:canFeed aio:AdvectionDispersionEquation ,
        aio:EngelundHansen ,
        aio:FiniteVolumeSedimentTransport ,
        aio:MeyerPeterMuller ;
    aiowf:fillsRole aiowf:Role_ChannelRouting ,
        aiowf:Role_Hydraulics ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#SCS-CN
aio:SCS-CN aiowf:canFeed aio:Clark-UH ,
        aio:ConceptualRoutingReservoir ,
        aio:DiffusiveWave2D ,
        aio:KinematicWave ,
        aio:LinearReservoir ,
        aio:ModClark ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:SCS-UH ,
        aio:ShallowWaterEquations2D ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall .

###  https://w3id.org/aio#SCS-UH
aio:SCS-UH aiowf:canFeed aio:ChannelElements1D ,
        aio:ManningsEquation ,
        aio:Muskingum-Cunge ,
        aio:Navier-StokesSimplified ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_RunoffTransform .

###  https://w3id.org/aio#ShallowWaterEquations2D
aio:ShallowWaterEquations2D aiowf:canFeed aio:AdvectionDispersionEquation ,
        aio:ChannelElements1D ,
        aio:EngelundHansen ,
        aio:FiniteVolumeSedimentTransport ,
        aio:MeyerPeterMuller ,
        aio:Muskingum-Cunge ,
        aio:Saint-VenantEquations1D ;
    aiowf:fillsRole aiowf:Role_Hydraulics ,
        aiowf:Role_RunoffTransform ;
    aiowf:hasInseparableRoles "false"^^xsd:boolean .

###  https://w3id.org/aio#SoilMoistureAccounting
aio:SoilMoistureAccounting aiowf:canFeed aio:BoussinesqEquation ,
        aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:DarcyEquation3D ,
        aio:FiniteDifferenceGroundwaterFlow ,
        aio:KinematicWave ,
        aio:KristenJensen ,
        aio:LinearReservoir ,
        aio:MoistureContentThresholds ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:RootzoneStress ,
        aio:SCS-UH ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall ,
        aiowf:Role_SoilWaterBudget ;
    aiowf:hasInseparableRoles "true"^^xsd:boolean .

###  https://w3id.org/aio#TemperatureIndexMethod
aio:TemperatureIndexMethod aiowf:canFeed aio:GR4Jmodel ,
        aio:Green-Ampt ,
        aio:HortonInfiltrationModel ,
        aio:LayeredSoilWaterBudget ,
        aio:PhilipsEquation ,
        aio:RichardsEquation ,
        aio:SCS-CN ,
        aio:SoilMoistureAccounting ,
        aio:VIC-RunoffGeneration ;
    aiowf:fillsRole aiowf:Role_Snow .

###  https://w3id.org/aio#Two-zoneGroundwaterModel
aio:Two-zoneGroundwaterModel aiowf:canFeed aio:ConceptualRoutingReservoir ,
        aio:Muskingum-Cunge ;
    aiowf:fillsRole aiowf:Role_Baseflow .

###  https://w3id.org/aio#VIC-RunoffGeneration
aio:VIC-RunoffGeneration aiowf:canFeed aio:Clark-UH ,
        aio:ConceptualGroundwaterReservoir ,
        aio:ConceptualRoutingReservoir ,
        aio:KinematicWave ,
        aio:KristenJensen ,
        aio:LinearReservoir ,
        aio:ModClark ,
        aio:MoistureContentThresholds ,
        aio:NonLinearReservoir ,
        aio:PollutantBuildupWashoff ,
        aio:RootzoneStress ,
        aio:SCS-UH ,
        aio:Two-zoneGroundwaterModel ;
    aiowf:fillsRole aiowf:Role_ExcessRainfall ,
        aiowf:Role_SoilWaterBudget ;
    aiowf:hasInseparableRoles "true"^^xsd:boolean .

