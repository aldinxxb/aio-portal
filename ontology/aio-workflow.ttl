###  https://w3id.org/aio/workflow#InternalCoupling
aiowf:InternalCoupling a aiowf:CouplingType ,
        owl:NamedIndividual ;
    rdfs:label "internal"@en ;
    skos:definition "Both components run inside the same software."@en .

###  https://w3id.org/aio/workflow#OfflineOneWay
aiowf:OfflineOneWay a aiowf:CouplingType ,
        owl:NamedIndividual ;
    rdfs:label "offline one-way"@en ;
    skos:definition "Outputs of one model are written to file and used as inputs of the next; no feedback."@en .

###  https://w3id.org/aio/workflow#Role_ActualET
aiowf:Role_ActualET a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "actual evapotranspiration"@en ;
    skos:definition "Reduces potential to actual evapotranspiration according to soil moisture and vegetation."@en .

###  https://w3id.org/aio/workflow#Role_Baseflow
aiowf:Role_Baseflow a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "baseflow"@en ;
    skos:definition "Computes the slow groundwater contribution to streamflow."@en .

###  https://w3id.org/aio/workflow#Role_ChannelRouting
aiowf:Role_ChannelRouting a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "channel routing"@en ;
    skos:definition "Propagates hydrographs along the river network."@en .

###  https://w3id.org/aio/workflow#Role_ExcessRainfall
aiowf:Role_ExcessRainfall a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "excess rainfall (runoff production)"@en ;
    skos:definition "Splits liquid water input into infiltration and excess rainfall."@en .

###  https://w3id.org/aio/workflow#Role_GroundwaterFlow
aiowf:Role_GroundwaterFlow a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "groundwater flow"@en ;
    skos:definition "Solves groundwater heads and fluxes in the aquifer."@en .

###  https://w3id.org/aio/workflow#Role_HeatTransport
aiowf:Role_HeatTransport a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "heat transport"@en ;
    skos:definition "Transports heat in water or the subsurface."@en .

###  https://w3id.org/aio/workflow#Role_Hydraulics
aiowf:Role_Hydraulics a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "hydraulics"@en ;
    skos:definition "Computes water depth and velocity in channels and floodplains (1D/2D/3D)."@en .

###  https://w3id.org/aio/workflow#Role_Interception
aiowf:Role_Interception a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "interception"@en ;
    skos:definition "Splits precipitation into interception loss and throughfall."@en .

###  https://w3id.org/aio/workflow#Role_Morphology
aiowf:Role_Morphology a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "morphological update"@en ;
    skos:definition "Updates bed elevation from sediment flux divergence."@en .

###  https://w3id.org/aio/workflow#Role_PET
aiowf:Role_PET a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "potential evapotranspiration"@en ;
    skos:definition "Estimates atmospheric evaporative demand."@en .

###  https://w3id.org/aio/workflow#Role_PollutantLoading
aiowf:Role_PollutantLoading a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "pollutant loading"@en ;
    skos:definition "Generates pollutant loads from land surfaces (build-up, wash-off)."@en .

###  https://w3id.org/aio/workflow#Role_RunoffTransform
aiowf:Role_RunoffTransform a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "runoff transform"@en ;
    skos:definition "Turns excess rainfall into an outflow hydrograph at the sub-catchment outlet."@en .

###  https://w3id.org/aio/workflow#Role_SedimentTransport
aiowf:Role_SedimentTransport a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "sediment transport"@en ;
    skos:definition "Computes sediment transport capacity or flux from the flow."@en .

###  https://w3id.org/aio/workflow#Role_Snow
aiowf:Role_Snow a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "snow accumulation and melt"@en ;
    skos:definition "Stores solid precipitation and releases melt water."@en .

###  https://w3id.org/aio/workflow#Role_SoilWaterBudget
aiowf:Role_SoilWaterBudget a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "soil water budget"@en ;
    skos:definition "Tracks soil moisture storage and percolation in the unsaturated zone."@en .

###  https://w3id.org/aio/workflow#Role_SoluteTransport
aiowf:Role_SoluteTransport a aiowf:ComponentRole ,
        owl:NamedIndividual ;
    rdfs:label "solute transport"@en ;
    skos:definition "Transports dissolved substances with the flow (advection, dispersion, decay)."@en .

###  https://w3id.org/aio/workflow#Tpl_ContinuousWaterBalance
aiowf:Tpl_ContinuousWaterBalance a aiowf:ChainTemplate ,
        owl:NamedIndividual ;
    aiowf:deliversOutput aio:EvapotranspirationSeries ,
        aio:Hydrograph ,
        aio:LowFlowIndicator ,
        aio:SnowWaterEquivalentSeries ,
        aio:SoilMoistureMap ,
        aio:WaterBalance ;
    aiowf:hasSlot aiowf:Tpl_ContinuousWaterBalance_S1 ,
        aiowf:Tpl_ContinuousWaterBalance_S10 ,
        aiowf:Tpl_ContinuousWaterBalance_S2 ,
        aiowf:Tpl_ContinuousWaterBalance_S3 ,
        aiowf:Tpl_ContinuousWaterBalance_S4 ,
        aiowf:Tpl_ContinuousWaterBalance_S5 ,
        aiowf:Tpl_ContinuousWaterBalance_S6 ,
        aiowf:Tpl_ContinuousWaterBalance_S7 ,
        aiowf:Tpl_ContinuousWaterBalance_S8 ,
        aiowf:Tpl_ContinuousWaterBalance_S9 ;
    aiowf:servesChallenge aio:ClimateChange ,
        aio:Drought ,
        aio:LandUseChange ,
        aio:WaterAvailabilty ;
    rdfs:label "continuous water balance"@en ;
    skos:definition "Long continuous simulation of the catchment water balance and streamflow."@en ;
    skos:note "The slow groundwater contribution must be represented: fill the baseflow slot or the groundwater-flow slot."@en .

###  https://w3id.org/aio/workflow#Tpl_ContinuousWaterBalance_S1
