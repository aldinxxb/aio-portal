@prefix aio: <https://w3id.org/aio#> .
@prefix aiosw: <https://w3id.org/aio/software#> .
@prefix aiowf: <https://w3id.org/aio/workflow#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#  AIO extension: software implementations 0.9.0. Imports the core and model composition.
#  More modules and workflows are generated into aio-software-generated.ttl by build_software_ttl.py.

###  https://w3id.org/aio/software
<https://w3id.org/aio/software> a owl:Ontology ;
    dct:description "How methods are realised in software: software modules with their usual time step and resolution, and curated reference chains (standard-practice workflows) with their steps."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-20"^^xsd:date ;
    dct:title "AIO extension - software implementations"@en ;
    owl:imports <https://w3id.org/aio/workflow> ,
        <https://w3id.org/aio> ;
    owl:versionIRI <https://w3id.org/aio/software/0.9.0> ;
    owl:versionInfo "0.9.0" ;
    vann:preferredNamespacePrefix "aiosw" ;
    vann:preferredNamespaceUri "https://w3id.org/aio/software#" .

#################################################################
#    Object properties
#################################################################

###  https://w3id.org/aio/software#chainUsesSoftware
aiosw:chainUsesSoftware a owl:ObjectProperty ;
    owl:propertyChainAxiom _:node3 ;
    rdfs:domain aiosw:ReferenceChain ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "chain uses software"@en ;
    rdfs:range aio:SoftwarePlatform ;
    skos:definition "Software needed to run the chain (inferred: hasStep ∘ stepSoftware)."@en .

###  https://w3id.org/aio/software#coversProcess
aiosw:coversProcess a owl:ObjectProperty ;
    owl:propertyChainAxiom _:node8 ;
    rdfs:domain aiosw:ReferenceChain ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "covers process"@en ;
    rdfs:range aio:Process ;
    skos:definition "Process modelled by at least one method of the chain (inferred: hasStep ∘ usesMethod ∘ modelsProcess)."@en .

###  https://w3id.org/aio/software#hasCouplingType
aiosw:hasCouplingType a owl:ObjectProperty ;
    rdfs:domain aiosw:ReferenceChain ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "has coupling type"@en ;
    rdfs:range aiowf:CouplingType ;
    skos:definition "How the components of the chain are coupled."@en .

###  https://w3id.org/aio/software#hasStep
aiosw:hasStep a owl:ObjectProperty ;
    rdfs:domain aiosw:ReferenceChain ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "has step"@en ;
    rdfs:range aiosw:ChainStep ;
    skos:definition "Step of the chain."@en .

###  https://w3id.org/aio/software#instantiatesTemplate
aiosw:instantiatesTemplate a owl:ObjectProperty ;
    rdfs:domain aiosw:ReferenceChain ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "instantiates template"@en ;
    rdfs:range aiowf:ChainTemplate ;
    skos:definition "Template that the chain follows."@en .

###  https://w3id.org/aio/software#stepRole
aiosw:stepRole a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiosw:ChainStep ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "step role"@en ;
    rdfs:range aiowf:ComponentRole ;
    skos:definition "Role filled by the method in this step."@en .

###  https://w3id.org/aio/software#stepSoftware
aiosw:stepSoftware a owl:ObjectProperty ;
    rdfs:domain aiosw:ChainStep ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "step software"@en ;
    rdfs:range aio:SoftwarePlatform ;
    skos:definition "Software that runs this step."@en .

###  https://w3id.org/aio/software#usesMethod
aiosw:usesMethod a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain aiosw:ChainStep ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "uses method"@en ;
    rdfs:range aio:ModelingMethod ;
    skos:definition "Method used in this step."@en .

#################################################################
#    Data properties
#################################################################

###  https://w3id.org/aio/software#stepOrder
aiosw:stepOrder a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain aiosw:ChainStep ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "step order"@en ;
    rdfs:range xsd:integer ;
    skos:definition "Position of the step from upstream (1) to downstream."@en .

#################################################################
#    Classes
#################################################################

###  https://w3id.org/aio/software#ChainStep
aiosw:ChainStep a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "chain step"@en ;
    skos:definition "One method placed in one role of a reference chain."@en .

###  https://w3id.org/aio/software#ReferenceChain
aiosw:ReferenceChain a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/aio/software> ;
    rdfs:label "reference chain"@en ;
    skos:definition "A curated, commonly used combination of methods for a chain template, with the software that implements it."@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/aio/software#implementsMethod
aiosw:implementsMethod rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleName
aiosw:moduleName rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleOf
aiosw:moduleOf rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleResolution
aiosw:moduleResolution rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleSpatialUnit
aiosw:moduleSpatialUnit rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleTimeStep
aiosw:moduleTimeStep rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#moduleTimeStepClass
aiosw:moduleTimeStepClass rdfs:isDefinedBy <https://w3id.org/aio/software> .

###  https://w3id.org/aio/software#RC_GR4J_Daily
aiosw:RC_GR4J_Daily a aiosw:ReferenceChain ,
        owl:NamedIndividual ;
    aiosw:chainUsesSoftware aio:Python-R ;
    aiosw:coversProcess aio:Baseflow ,
        aio:Evapotranspiration ,
        aio:Runoff ;
    aiosw:hasCouplingType aiowf:InternalCoupling ;
    aiosw:hasStep aiosw:RC_GR4J_Daily_S1 ,
        aiosw:RC_GR4J_Daily_S2 ,
        aiosw:RC_GR4J_Daily_S3 ,
        aiosw:RC_GR4J_Daily_S4 ,
        aiosw:RC_GR4J_Daily_S5 ;
    aiosw:instantiatesTemplate aiowf:Tpl_ContinuousWaterBalance ;
    rdfs:label "GR4J daily (R/Python)"@en ;
    skos:note "Parsimonious lumped model (4 parameters); airGR in R."@en .

###  https://w3id.org/aio/software#RC_GR4J_Daily_S1
aiosw:RC_GR4J_Daily_S1 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "1"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_PET ;
    aiosw:stepSoftware aio:Python-R ;
    aiosw:usesMethod aio:HargeavesMethod ;
    rdfs:label "GR4J daily (R/Python) – 1: Hargreaves method"@en .

###  https://w3id.org/aio/software#RC_GR4J_Daily_S2
aiosw:RC_GR4J_Daily_S2 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "2"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_SoilWaterBudget ;
    aiosw:stepSoftware aio:Python-R ;
    aiosw:usesMethod aio:GR4Jmodel ;
    rdfs:label "GR4J daily (R/Python) – 2: GR4J model"@en .

###  https://w3id.org/aio/software#RC_GR4J_Daily_S3
aiosw:RC_GR4J_Daily_S3 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "3"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_ExcessRainfall ;
    aiosw:stepSoftware aio:Python-R ;
    aiosw:usesMethod aio:GR4Jmodel ;
    rdfs:label "GR4J daily (R/Python) – 3: GR4J model"@en .

###  https://w3id.org/aio/software#RC_GR4J_Daily_S4
aiosw:RC_GR4J_Daily_S4 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "4"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_RunoffTransform ;
    aiosw:stepSoftware aio:Python-R ;
    aiosw:usesMethod aio:GR4Jmodel ;
    rdfs:label "GR4J daily (R/Python) – 4: GR4J model"@en .

###  https://w3id.org/aio/software#RC_GR4J_Daily_S5
aiosw:RC_GR4J_Daily_S5 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "5"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_Baseflow ;
    aiosw:stepSoftware aio:Python-R ;
    aiosw:usesMethod aio:GR4Jmodel ;
    rdfs:label "GR4J daily (R/Python) – 5: GR4J model"@en .

###  https://w3id.org/aio/software#RC_HECRAS_1DSediment
aiosw:RC_HECRAS_1DSediment a aiosw:ReferenceChain ,
        owl:NamedIndividual ;
    aiosw:chainUsesSoftware aio:HEC-RAS ;
    aiosw:coversProcess aio:ChannelFlow ,
        aio:SedimentTransport ;
    aiosw:hasCouplingType aiowf:InternalCoupling ;
    aiosw:hasStep aiosw:RC_HECRAS_1DSediment_S1 ,
        aiosw:RC_HECRAS_1DSediment_S2 ,
        aiosw:RC_HECRAS_1DSediment_S3 ;
    aiosw:instantiatesTemplate aiowf:Tpl_Morphodynamics ;
    rdfs:label "HEC-RAS 1D sediment"@en .

###  https://w3id.org/aio/software#RC_HECRAS_1DSediment_S1
aiosw:RC_HECRAS_1DSediment_S1 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "1"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_Hydraulics ;
    aiosw:stepSoftware aio:HEC-RAS ;
    aiosw:usesMethod aio:Saint-VenantEquations1D ;
    rdfs:label "HEC-RAS 1D sediment – 1: 1D Saint-Venant equations"@en .

###  https://w3id.org/aio/software#RC_HECRAS_1DSediment_S2
aiosw:RC_HECRAS_1DSediment_S2 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "2"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_SedimentTransport ;
    aiosw:stepSoftware aio:HEC-RAS ;
    aiosw:usesMethod aio:EngelundHansen ;
    rdfs:label "HEC-RAS 1D sediment – 2: Engelund–Hansen formula"@en .

###  https://w3id.org/aio/software#RC_HECRAS_1DSediment_S3
aiosw:RC_HECRAS_1DSediment_S3 a aiosw:ChainStep ,
        owl:NamedIndividual ;
    aiosw:stepOrder "3"^^xsd:integer ;
    aiosw:stepRole aiowf:Role_Morphology ;
    aiosw:stepSoftware aio:HEC-RAS ;
    aiosw:usesMethod aio:ExnerEquation ;
    rdfs:label "HEC-RAS 1D sediment – 3: Exner equation"@en .

