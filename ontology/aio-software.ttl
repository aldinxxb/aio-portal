###  https://w3id.org/aio/software#SoftwareModule
aiosw:SoftwareModule rdfs:isDefinedBy <https://w3id.org/aio/software> .

#################################################################
#    Anonymous expressions
#################################################################

_:node10 rdf:first aio:modelsProcess ;
    rdf:rest rdf:nil .

_:node3 rdf:first aiosw:hasStep ;
    rdf:rest _:node4 .

_:node4 rdf:first aiosw:stepSoftware ;
    rdf:rest rdf:nil .

_:node8 rdf:first aiosw:hasStep ;
    rdf:rest _:node9 .

_:node9 rdf:first aiosw:usesMethod ;
    rdf:rest _:node10 .
