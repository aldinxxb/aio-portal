###  https://w3id.org/aio/software#RC_MIKESHE_MIKE11
aiosw:RC_MIKESHE_MIKE11 a aiosw:ReferenceChain ,
        owl:NamedIndividual ;
    aiosw:chainUsesSoftware aio:MIKE11 ,
        aio:MIKESHE ;
    aiosw:coversProcess aio:Baseflow ,
        aio:ChannelFlow ,
        aio:Evapotranspiration ,
        aio:GroundWaterFlow ,
